<Window x:Class="KrushiBillERP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KrushiBill ERP - Login"
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/logo.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left brand panel -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="110" Height="110" Margin="0,0,0,20"/>
                <TextBlock Text="KrushiBill ERP" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Seeds &amp; PeSticides Billing Software" FontSize="14" Foreground="#DDEEDD"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

		<!-- Right login form -->
		<Grid Grid.Column="1" Background="White">
			<StackPanel VerticalAlignment="Center" Margin="60,0">
				<TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
				<TextBlock Text="Please sign in to continue to your dashboard" FontSize="13" Foreground="Gray" Margin="0,4,0,30"/>

				<TextBlock Text="Username" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
				<TextBox x:Name="TxtUsername" Height="38" Margin="0,0,0,18" KeyDown="Input_KeyDown"/>

				<TextBlock Text="Password" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
				<Grid Margin="0,0,0,10">
					<PasswordBox x:Name="TxtPassword" Height="38" Padding="8,6" Margin="0"
                                 VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/>
					<TextBox x:Name="TxtPasswordVisible" Height="38" Padding="8,6" Margin="0"
                             VerticalContentAlignment="Center" KeyDown="Input_KeyDown"
                             Visibility="Collapsed"/>
					<ToggleButton x:Name="BtnTogglePassword" Content="👁" FontSize="14"
                                  Width="32" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                  Click="BtnTogglePassword_Click" ToolTip="Show/Hide password"/>
				</Grid>

				<TextBlock x:Name="TxtError" Foreground="#D32F2F" FontSize="12" Margin="0,0,0,10"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

				<Button Content="Sign In" Style="{StaticResource PrimaryButton}" Height="42" Padding="12,8"
                        Click="BtnLogin_Click" Margin="0,10,0,0"/>

				<TextBlock Text="Default credentials: admin / admin123 — please change after firSt login."
                           FontSize="11" Foreground="#AAAAAA" Margin="0,20,0,0" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
			</StackPanel>
		</Grid>
    </Grid>
</Window>
