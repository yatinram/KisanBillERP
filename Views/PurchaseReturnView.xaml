<UserControl x:Class="KrushiBillERP.Views.PurchaseReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KrushiBillERP.Views">

    <UserControl.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="PageBg" Color="#F4F6F5"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E7EBE8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="MutedText" Color="#6C757D"/>
        <SolidColorBrush x:Key="HeadingText" Color="#1E2422"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        <!-- Converters used for payment/Status visuals (same as PurchaseView) -->
        <local:PaymentStatusToBrushConverter x:Key="PaymentStatusToBrushConverter" />
        <local:PaymentStatusToBgConverter x:Key="PaymentStatusToBgConverter" />

        <!-- TextBlock Style for centering cell content vertically -->
        <Style x:Key="CellTextBlockCenter" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- TextBlock Style for centering Horizontally and vertically -->
        <Style x:Key="CellTextBlockCenterBoth" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="BorderBrush" Value="#DADFDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Purchase Returns" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
                <TextBlock Text="Manage returned purchases and supplier Adjustments" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="BtnAddReturn" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="BtnAddReturn_Click" Style="{StaticResource PrimaryButton}" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="New Purchase Return" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Card Body -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search & Refresh bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSearch" Height="40" Style="{StaticResource SearchTextBox}"
                             KeyUp="TxtSearch_KeyUp" ToolTip="Search return no, purchase no, supplier..."/>

                    <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search return no., purchase no., supplier..."
                               IsHitTestVisible="False" Foreground="#9E9E9E" FontSize="13.5"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <Button Grid.Column="1" Height="40" Padding="12,8" Margin="12,0,0,0"
                            Click="BtnRefresh_Click" Style="{StaticResource RefreshButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="â†» " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- History DataGrid: use same UI as Purchase Entry table -->
                <DataGrid x:Name="GridReturns" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column"
                          Style="{StaticResource PremiumDataGridStyle}" ColumnWidth="Auto" RowHeight="52"
                          Background="White" BorderThickness="1" BorderBrush="#E5EAE7"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding PurchaseReturnId}" Width="60" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTemplateColumn Header="Return No." Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnNumber}" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Purchase No." Binding="{Binding PurchaseNumber}" Width="160" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" ElementStyle="{StaticResource CellTextBlockCenter}"/>
                        <DataGridTextColumn Header="Supplier Invoice No." Binding="{Binding SupplierInvoiceNumber}" Width="140" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat=dd MMM yyyy}" Width="130" />
                        <DataGridTemplateColumn Header="Return Amount" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Payment Status" Width="160" HeaderStyle="{StaticResource PremiumHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PaymentStatus}" Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBrushConverter}}" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="👁  View" Click="BtnView_Click" Tag="{Binding PurchaseReturnId}" Style="{StaticResource ViewActionButton}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

				<!-- Pagination Footer -->
				<Grid Grid.Row="2" Margin="0,16,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
						<TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
						<TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0"/>
						<ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="PageSize_Changed">
							<ComboBoxItem Content="10" IsSelected="True"/>
							<ComboBoxItem Content="25"/>
							<ComboBoxItem Content="50"/>
							<ComboBoxItem Content="100"/>
						</ComboBox>
						<TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="6,0,0,0"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Grid.Column="1">
						<Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
						<StackPanel x:Name="PanelPageNumbers" Orientation="Horizontal" VerticalAlignment="Center"/>
						<Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click" Margin="8,0,0,0"/>
					</StackPanel>
				</Grid>
            </Grid>
        </Border>

    </Grid></UserControl>



