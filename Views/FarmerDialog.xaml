<Window x:Class="KrushiBillERP.Views.FarmerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Farmer" Height="420" Width="560" MinWidth="500" MinHeight="380" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add / Edit Farmer" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>

        <!-- Form: use two-column grid for better visibility -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Column -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Farmer Name *" FontWeight="SemiBold" FontSize="12.5"/>
                <TextBox x:Name="TxtName" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                <TextBlock Text="Mobile Number *" FontWeight="SemiBold" FontSize="12.5"/>
                <TextBox x:Name="TxtMobile" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                <TextBlock Text="Village Name *" FontWeight="SemiBold" FontSize="12.5"/>
                <TextBox x:Name="TxtVillage" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Right Column (Opening Balance & Type) -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Opening Balance Amount (₹)" FontWeight="SemiBold" FontSize="12.5"/>
                <TextBox x:Name="TxtOpeningBalance" Text="0.00" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                <TextBlock Text="Balance Type" FontWeight="SemiBold" FontSize="12.5"/>
                <ComboBox x:Name="CmbOpeningBalanceType" Height="36" Style="{StaticResource ModernComboBox}" Margin="0,4,0,12">
                    <ComboBoxItem Content="Udhar (ઉધાર / Outstanding Debit)" Tag="Udhar" IsSelected="True"/>
                    <ComboBoxItem Content="Jama (જમા / Advance Deposit)" Tag="Jama"/>
                </ComboBox>

                <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                    <TextBlock Text="💡 Note: Jama (Advance) indicates money deposited by farmer in advance. Udhar indicates initial debt." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Height="36" Width="100" Padding="10,6" Margin="0,0,8,0" Click="BtnCancel_Click" />
            <Button x:Name="BtnSave" Content="Save Farmer" Style="{StaticResource PrimaryButton}" Height="36" Width="120" Padding="12,6" Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
