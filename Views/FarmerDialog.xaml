<Window x:Class="KrushiBillERP.Views.FarmerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Farmer" Height="340" Width="560" WindowStartupLocation="CenterOwner" ResizeMode="CanReSize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add / Edit Farmer" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>

        <!-- Form: use two-column grid for better visibility -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
               
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                <TextBlock Text="Farmer Name *" />
                <TextBox x:Name="TxtName" Height="34" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Mobile Number *" Margin="0,8,0,0"/>
                <TextBox x:Name="TxtMobile" Height="34" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Village Name *" Margin="0,8,0,0"/>
                <TextBox x:Name="TxtVillage" Height="34" Padding="8,0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
            </StackPanel>

                   </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Height="34" Width="100" Padding="10,6" Margin="0,0,8,0" Click="BtnCancel_Click" />
            <Button x:Name="BtnSave" Content="Save Farmer" Style="{StaticResource PrimaryButton}" Height="34" Width="120" Padding="12,6" Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
