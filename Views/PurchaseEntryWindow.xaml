<Window x:Class="KrushiBillERP.Views.PurchaseEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Purchase Entry" Height="820" Width="1040"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F5">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryColor">#2E7D32</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryDark">#1B5E20</SolidColorBrush>
        <SolidColorBrush x:Key="TextDark">#1E2422</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#6C757D</SolidColorBrush>
        <SolidColorBrush x:Key="BorderColor">#E0E5E2</SolidColorBrush>

        <!-- Section Border Card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Section Header Text -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Field Label Text -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Field TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderTitle" Text="New Purchase Entry" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Create a purchase entry from supplier" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="BtnClose_Click" Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                    FontSize="16" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Form Content (Single ScrollViewer) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!-- SUPPLIER & INVOICE DETAILS CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="SUPPLIER &amp; INVOICE DETAILS" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Supplier Name (MUSt BE TEXT INPUT) -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Supplier Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="TxtSupplierName" Style="{StaticResource FormTextBox}"
                                             KeyUp="TxtSupplierName_KeyUp" LostFocus="TxtSupplierName_LostFocus"/>
                                    <Popup x:Name="PopSupplierSuggestions" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtSupplierName}" Placement="Bottom" Width="{Binding ElementName=TxtSupplierName, Path=ActualWidth}">
                                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="180">
                                            <ListBox x:Name="LstSupplierSuggestions" BorderThickness="0" MouseUp="LstSupplierSuggestions_MouseUp"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <!-- Purchase Date -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Purchase Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <DatePicker x:Name="DpPurchaseDate" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Supplier Invoice No -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Supplier Invoice No." Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtSupplierInvoice" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ADD PRODUCT CARD -->
                <Border x:Name="CardAddProduct" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="ADD PRODUCT" Style="{StaticResource SectionHeader}"/>

                        <!-- Row 1: Product Name, Company, Category, Pack Size, Unit -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Product Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="TxtProductName" Style="{StaticResource FormTextBox}"
                                             KeyUp="TxtProductName_KeyUp" LostFocus="TxtProductName_LostFocus"/>
                                    <Popup x:Name="PopProductSuggestions" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtProductName}" Placement="Bottom" Width="{Binding ElementName=TxtProductName, Path=ActualWidth}">
                                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" MaxHeight="200">
                                            <ListBox x:Name="LstProductSuggestions" BorderThickness="0" DisplayMemberPath="Name" MouseUp="LstProductSuggestions_MouseUp"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Company Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtCompany" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbCategory" Style="{StaticResource FormComboBox}" IsEditable="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pack Size" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPackSize" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbUnit" Style="{StaticResource FormComboBox}" IsEditable="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: HSN Code, Purchase Price, GST, Batch -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="HSN Code" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtHSN" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Purchase Price (₹)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPurchasePrice" Style="{StaticResource FormTextBox}" TextChanged="ProductInput_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="GST %" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtGST" Style="{StaticResource FormTextBox}" TextChanged="ProductInput_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtBatch" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Expiry Date, Quantity, Free Quantity, Add Button -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Expiry Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <DatePicker x:Name="DpExpiry" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Purchase Qty" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtQty" Style="{StaticResource FormTextBox}" TextChanged="ProductInput_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Free Quantity" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtFreeQty" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <Button x:Name="BtnAddProduct" Grid.Column="3" Content="🔄 Add Product"
                                    Height="36" Padding="18,0" VerticalAlignment="Bottom"
                                    Click="BtnAddProduct_Click" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PURCHASE ITEMS CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PURCHASE ITEMS" Style="{StaticResource SectionHeader}"/>

                        <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="36"
                                  MaxHeight="260" Background="White" BorderThickness="1" BorderBrush="#E5EAE7">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAF9"/>
                                    <Setter Property="Foreground" Value="#495057"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding PurchaseItemId}" Width="40" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="1.8*" />
                                <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="1.2*" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}" Width="110" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="Free" Binding="{Binding FreeQuantity}" Width="60" />
                                <DataGridTemplateColumn Header="P. Price" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PurchasePrice, StringFormat='₹ {0:N2}'}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="GST" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GST, StringFormat='{}{0}%'}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Amount" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Amount, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColAction" Header="Action" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 Remove" Click="BtnRemoveItem_Click"
                                                    Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                                                    Padding="8,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- PAYMENT DETAILS & PURCHASE SUMMARY CARD -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PAYMENT DETAILS -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="PAYMENT DETAILS" Style="{StaticResource SectionHeader}"/>

                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Payment Mode" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbPaymentMode" Style="{StaticResource FormComboBox}" SelectionChanged="CmbPaymentMode_SelectionChanged">
                                    <ComboBoxItem Content="Cash" IsSelected="True"/>
                                    <ComboBoxItem Content="UPI / Online"/>
                                    <ComboBoxItem Content="Credit"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="PanelPaidAmount" Margin="0,0,0,10">
                                <TextBlock Text="Amount Paid (₹)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPaidAmount" Style="{StaticResource FormTextBox}" TextChanged="TxtPaidAmount_TextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelPaymentRef" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LblPaymentRef" Text="Transaction Reference / UTR" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="StarPaymentRef" Text=" *" Foreground="#DC2626" FontWeight="Bold" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBox x:Name="TxtPaymentRef" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Payable Amount (₹) 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPayableAmount" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="#F3F4F6" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PURCHASE SUMMARY -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="PURCHASE SUMMARY" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtSubTotal" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Discount (₹)" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtDiscount" Width="120" Height="30" HorizontalAlignment="Right" Style="{StaticResource FormTextBox}" TextChanged="TxtDiscount_TextChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Taxable Amount" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtTaxableAmount" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="GST Amount" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtGstAmount" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Round Off" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtRoundOff" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,8,0,10" Background="#E5E7EB"/>

                            <Grid>
                                <TextBlock Text="GRAND TOTAL" FontSize="15" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock x:Name="TxtGrandTotal" Text="₹ 0.00" FontSize="18" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- NOTES -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNotes" Style="{StaticResource FormTextBox}" Height="54" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtSavingStatus" Text="" Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" Height="40" Padding="20,0" Margin="0,0,0,10"/>
                <Button x:Name="BtnSavePurchase" Content="✓ Save Purchase" Click="BtnSavePurchase_Click" Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
