<UserControl x:Class="KrushiBillERP.Views.PaymentReceiptView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HeadingText" Color="#1B5E20"/>
        <SolidColorBrush x:Key="MutedText" Color="#6B7280"/>
        <SolidColorBrush x:Key="PageBg" Color="#F3F4F6"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageNavBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Payment Receipts" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
                <TextBlock Text="Manage customer payments and outstanding adjustments" FontSize="14" Foreground="{StaticResource MutedText}" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BtnAddReceipt" Content="+ New Payment Receipt" Style="{StaticResource PrimaryButton}"
                    Padding="16,10" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Click="BtnAddReceipt_Click"/>
        </Grid>

        <!-- Card Body -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search and Refresh -->
                <Grid Grid.Row="0" Margin="20,20,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch" Style="{StaticResource SearchTextBox}" KeyUp="TxtSearch_KeyUp"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search by receipt no., customer name or mobile number..."
                                   Foreground="#999999" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Button Grid.Column="2" x:Name="BtnRefresh" Style="{StaticResource RefreshButton}"
                            Width="112" Height="38" Click="BtnRefresh_Click"/>
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" x:Name="GridReceipts" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          Style="{StaticResource PremiumDataGridStyle}" RowHeight="52"
                          Background="White" BorderThickness="0" Margin="0,10,0,10"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F8F1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Resources>
                        <Style x:Key="CellTextBlockCenter" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                        <Style x:Key="CellTextBlockCenterBoth" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding PaymentReceiptId}" Width="60" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Receipt No." Binding="{Binding ReceiptNumber}" Width="160" FontWeight="Bold" Foreground="#1B5E20" />
                        <DataGridTextColumn Header="Customer/Farmer" Binding="{Binding FarmerName}" Width="*" />
                        <DataGridTextColumn Header="Receipt Date" Binding="{Binding ReceiptDate, StringFormat='dd MMM yyyy'}" Width="140" ElementStyle="{StaticResource CellTextBlockCenter}" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding ReceivedAmount, StringFormat='₹{0:N2}'}" Width="140" FontWeight="Bold" ElementStyle="{StaticResource CellTextBlockCenter}" />

                        <!-- Payment Mode Column -->
                        <DataGridTemplateColumn Header="Payment Mode" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentMode}" Value="Cash">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentMode}" Value="UPI">
                                                        <Setter Property="Background" Value="#E0F2FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentMode}" Value="Online">
                                                        <Setter Property="Background" Value="#E0F2FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentMode}" Value="Cheque">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PaymentMode}" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="Cash">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="UPI">
                                                            <Setter Property="Foreground" Value="#0284C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="Online">
                                                            <Setter Property="Foreground" Value="#0284C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="Cheque">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View" Style="{StaticResource ViewActionButton}" Margin="0,0,8,0" Tag="{Binding PaymentReceiptId}" Click="BtnView_Click"/>
                                        <Button Content="Print" Style="{StaticResource PrintActionButton}" Tag="{Binding PaymentReceiptId}" Click="BtnPrint_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E7EBE8" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
                            <TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="PageSize_Changed">
                                <ComboBoxItem Content="10" IsSelected="True"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>
                            </ComboBox>
                            <TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
                            <StackPanel x:Name="PanelPageNumbers" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
