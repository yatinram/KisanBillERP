<UserControl x:Class="KrushiBillERP.Views.PurchaseView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:KrushiBillERP.Views"
			 Background="#F4F6F5">

	<UserControl.Resources>
		<local:PaymentStatusToBrushConverter x:Key="PaymentStatusToBrushConverter" />
		<local:PaymentStatusToBgConverter x:Key="PaymentStatusToBgConverter" />

		<!-- Palette -->
		<SolidColorBrush x:Key="PageBg" Color="#F4F6F5"/>
		<SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
		<SolidColorBrush x:Key="CardBorder" Color="#E7EBE8"/>
		<SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
		<SolidColorBrush x:Key="AccentGreenDark" Color="#1B5E20"/>
		<SolidColorBrush x:Key="MutedText" Color="#6C757D"/>
		<SolidColorBrush x:Key="HeadingText" Color="#1E2422"/>
		<SolidColorBrush x:Key="RowHover" Color="#F5FAF5"/>

		<!-- Drop shadow -->
		<DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>

		<!-- Card Style -->
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource CardBg}"/>
			<Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Effect" Value="{StaticResource CardShadow}"/>
		</Style>

		<Style x:Key="PrimaryGreenButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentGreen}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="FontSize" Value="13.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGreenDark}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>


		<Style x:Key="SearchTextBox" TargetType="TextBox">
			<Setter Property="Padding" Value="12,0,12,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13.5"/>
			<Setter Property="BorderBrush" Value="#DADFDC"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="ViewActionButton" TargetType="Button">
			<Setter Property="Background" Value="#E8F5E9"/>
			<Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="CellTextBlockCenter" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
		</Style>

		<Style x:Key="CellTextBlockCenterBoth" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="PageNavBtn" TargetType="Button">
			<Setter Property="Height" Value="34"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
								BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bd" Property="Opacity" Value="0.35"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Margin="20" Background="{StaticResource PageBg}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<Grid Grid.Row="0" Margin="0,0,0,16">
			<StackPanel VerticalAlignment="Center">
				<TextBlock Text="Purchase Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
				<TextBlock Text="Manage supplier purchases and inventory purchases" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/>
			</StackPanel>

			<Button x:Name="BtnAdd" Content="+ Add Purchase Entry" HorizontalAlignment="Right" VerticalAlignment="Center"
					Click="BtnAdd_Click" Style="{StaticResource PrimaryGreenButton}"/>
		</Grid>

		<!-- Main Card Content -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Search & Refresh bar -->
				<Grid Grid.Row="0" Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Grid Grid.Column="0">
						<TextBox x:Name="TxtSearch" Height="40" Style="{StaticResource SearchTextBox}"
								 KeyUp="TxtSearch_KeyUp" ToolTip="Search purchase / invoice / supplier..."/>

						<TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search purchase / invoice / supplier..."
								   IsHitTestVisible="False" Foreground="#9E9E9E" FontSize="13.5"
								   VerticalAlignment="Center" Margin="14,0,0,0"/>
					</Grid>

					<Button x:Name="BtnRefresh" Grid.Column="1" Height="38" Width="112" Margin="12,0,0,0"
							Click="BtnRefresh_Click" Style="{StaticResource RefreshButton}"/>
				</Grid>

				<!-- Data Grid -->
				<DataGrid x:Name="GridPurchases" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
						  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" HeadersVisibility="Column"
						  Style="{StaticResource PremiumDataGridStyle}" ColumnWidth="*" RowHeight="52"
						  Background="White" BorderThickness="0"
						  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
					<DataGrid.Columns>
						<DataGridTextColumn Header="No" Binding="{Binding PurchaseId}" Width="60" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
						<DataGridTemplateColumn Header="Purchase No." Width="160">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding PurchaseNumber}" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" ElementStyle="{StaticResource CellTextBlockCenter}"/>
						<DataGridTextColumn Header="Supplier Invoice No." Binding="{Binding SupplierInvoiceNumber}" Width="160" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
						<DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDate, StringFormat=dd MMM yyyy}" Width="140" ElementStyle="{StaticResource CellTextBlockCenter}"/>
						<DataGridTemplateColumn Header="Amount" Width="130">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="Payment Status" Width="140">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}"
											CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
										<TextBlock Text="{Binding PaymentStatus}"
												   Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBrushConverter}}"
												   FontSize="11.5" FontWeight="Bold"/>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="Actions" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="👁 View" Click="BtnView_Click" Tag="{Binding PurchaseId}" Style="{StaticResource ViewActionButton}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<!-- Pagination Footer -->
				<Grid Grid.Row="2" Margin="0,16,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
						<TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
						<TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0"/>
						<ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="PageSize_Changed">
							<ComboBoxItem Content="10" IsSelected="True"/>
							<ComboBoxItem Content="25"/>
							<ComboBoxItem Content="50"/>
							<ComboBoxItem Content="100"/>
						</ComboBox>
						<TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="6,0,0,0"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Grid.Column="1">
						<Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
						<StackPanel x:Name="PanelPageNumbers" Orientation="Horizontal" VerticalAlignment="Center"/>
						<Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click" Margin="8,0,0,0"/>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>

	</Grid>
</UserControl>
