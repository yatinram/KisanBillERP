<Window x:Class="KrushiBillERP.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KrushiBill ERP" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico"
        Background="{StaticResource LightBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,0,26">
                    <Image Source="/Assets/logo.png" Width="34" Height="34"/>
                    <TextBlock Text="KrushiBill" Foreground="White" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="NavDashboard" Content="🏠   Dashboard" Style="{StaticResource SideNavButton}" Click="NavDashboard_Click"/>
                        <Button x:Name="NavBilling" Content="🧾  New Billing" Style="{StaticResource SideNavButton}" Click="NavBilling_Click"/>
                        <Button x:Name="NavInvoices" Content="📜  Bill History" Style="{StaticResource SideNavButton}" Click="NavInvoices_Click"/>
                        <Button x:Name="NavSalesReturn" Content="↩️  Sales Return" Style="{StaticResource SideNavButton}" Click="NavSalesReturn_Click"/>
                        <Button x:Name="NavPaymentReceipts" Content="💳  Payment Receipts" Style="{StaticResource SideNavButton}" Click="NavPaymentReceipts_Click"/>
                        <Button x:Name="NavFarmers" Content="👨‍🌾  Farmers" Style="{StaticResource SideNavButton}" Click="NavFarmers_Click"/>
                        <Button x:Name="NavProducts" Content="🌾  Products" Style="{StaticResource SideNavButton}" Click="NavProducts_Click"/>
                        <Button x:Name="NavStock" Content="📊  Stock Management" Style="{StaticResource SideNavButton}" Click="NavStock_Click"/>
                        <Button x:Name="NavPurchase" Content="📦  Purchase Entry" Style="{StaticResource SideNavButton}" Click="NavPurchase_Click"/>
                        <Button x:Name="NavPurchaseReturn" Content="↩️  Purchase Return" Style="{StaticResource SideNavButton}" Click="NavPurchaseReturn_Click"/>
                        <Button x:Name="NavReports" Content="📈  Reports &amp; Analytics" Style="{StaticResource SideNavButton}" Click="NavReports_Click"/>
                        <Button x:Name="NavSettings" Content="⚙️  Company Settings" Style="{StaticResource SideNavButton}" Click="NavSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Button DockPanel.Dock="Bottom" Content="⏻  Logout" Style="{StaticResource SideNavButton}"
                        Margin="0,10,0,20" Click="BtnLogout_Click" Foreground="#FFB4B4"/>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: dynamically shows the logged-in user's shop & name -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtShopName" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                        <TextBlock x:Name="TxtShopAddress" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUserName" FontSize="13" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource PrimaryColor}" CornerRadius="18" Width="36" Height="36">
                            <TextBlock x:Name="TxtUserInitial" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="20"/>
        </Grid>
    </Grid>
</Window>
