<Window x:Class="KrushiBillERP.Views.ProductSalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product History" Height="700" Width="1050"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E2422"/>
        <SolidColorBrush x:Key="MutedText" Color="#6C757D"/>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="1810"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0FDF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Product History" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock x:Name="TxtSubtitle" Text="Complete purchase and sales History for this product" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="32" Height="32" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="BtnClose_Click"/>
        </Grid>

        <!-- Product Info Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14"
                BorderBrush="#E7EBE8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRODUCT NAME" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="TxtProductName" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="COMPANY" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="TxtCompany" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CURRENT StOCK" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="TxtCurrentStock" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="BATCH / EXPIRY" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="TxtBatchExpiry" FontSize="14" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="SELLING PRICE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="TxtPrice" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Stat Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL PURCHASED" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                    <TextBlock x:Name="StatPurchased" Text="0" FontSize="20" FontWeight="Bold" Foreground="#15803D" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="10" Padding="14" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="TOTAL SOLD" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                    <TextBlock x:Name="StatSold" Text="0" FontSize="20" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="10" Padding="14" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="TOTAL REVENUE" FontSize="10" FontWeight="Bold" Foreground="#075985"/>
                    <TextBlock x:Name="StatRevenue" Text="₹ 0" FontSize="20" FontWeight="Bold" Foreground="#0369A1" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#F3E8FF" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="UNIQUE CustOMERS" FontSize="10" FontWeight="Bold" Foreground="#6B21A8"/>
                    <TextBlock x:Name="StatCustomers" Text="0" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tab Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="TabSales" Content="📊 Sales History (Customer-wise)" Style="{StaticResource TabBtn}" Click="TabSales_Click"/>
            <Button x:Name="TabPurchases" Content="📦 Purchase History (Supplier-wise)" Style="{StaticResource TabBtn}" Click="TabPurchases_Click"/>
        </StackPanel>

        <!-- Sales History DataGrid -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="12" BorderBrush="#E7EBE8" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="GridSales" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowHeight="38" Background="White" BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAF9"/>
                            <Setter Property="Foreground" Value="#495057"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5EAE7"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice No." Binding="{Binding InvoiceNo}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDateDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Farmer Name" Binding="{Binding CustomerName}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhone}" Width="120"/>
                        <DataGridTextColumn Header="Qty Sold" Binding="{Binding Qty}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#B45309"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Rate ₹" Binding="{Binding Rate, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="GST %" Binding="{Binding GSTPercent}" Width="70"/>
                        <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Purchase History DataGrid (hidden by default) -->
                <DataGrid x:Name="GridPurchases" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowHeight="38" Background="White" BorderThickness="0" Visibility="Collapsed">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAF9"/>
                            <Setter Property="Foreground" Value="#495057"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5EAE7"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="No." Binding="{Binding PurchaseNumber}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0284C7"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDateDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#15803D"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Free" Binding="{Binding FreeQuantity}" Width="60"/>
                        <DataGridTextColumn Header="Total Qty" Binding="{Binding TotalQty}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Price ₹" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100"/>
                        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplay}" Width="110"/>
                        <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <TextBlock x:Name="TxtEmpty" Text="No records found for this product." 
                           Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" Foreground="#9CA3AF" Margin="0,40,0,0"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Width="120" Height="38" Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
