<UserControl x:Class="KrushiBillERP.Views.SalesReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#F4F6F5"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E7EBE8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="MutedText" Color="#6C757D"/>
        <SolidColorBrush x:Key="HeadingText" Color="#1E2422"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sales Returns (àªµà«‡àªšàª¾àª£ àªªàª°àª¤ àª°àªœàª¿àª¸à«àªŸàª°)" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
                <TextBlock Text="Manage farmer returned items, Restore Stock and track credit/refund Adjustments" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="BtnAddReturn" Content="🔄 New Sales Return" Click="BtnAddReturn_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main Card Body -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <TextBox x:Name="TxtSearch" FontSize="13" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyUp="TxtSearch_KeyUp"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search by return no., invoice no., farmer name or mobile number..." Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnRefresh" Style="{StaticResource RefreshButton}" Grid.Column="1" Content="🔍„ Refresh" Click="BtnRefresh_Click" BorderBrush="#E5EAE7" BorderThickness="1" Padding="14,8" Cursor="Hand"/>
                </Grid>

                <!-- Sales Returns DataGrid: allocate full available space so columns are fully visible -->
                <DataGrid x:Name="GridReturns" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column"
                          Background="White" BorderThickness="1" BorderBrush="#E5EAE7"
                          Style="{StaticResource PremiumDataGridStyle}" ColumnWidth="*"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding SalesReturnId}" Width="50"/>
                        <DataGridTextColumn Header="Return No." Binding="{Binding ReturnNumber}" Width="160" FontWeight="Bold" Foreground="#1B5E20"/>
                        <!-- Make Bill No wider so invoice text is visible -->
                        <DataGridTemplateColumn Header="Bill No." Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InvoiceNo}" FontWeight="SemiBold" TextTrimming="None" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- spacer column -->
                        <DataGridTextColumn Header="" Width="24" CanUserResize="False" IsReadOnly="True"/>
                        <!-- Farmer Name gets fixed generous width to avoid truncation -->
                        <DataGridTemplateColumn Header="Farmer Name" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FarmerName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat='dd MMM yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Return Total" Binding="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" Width="120" FontWeight="Bold"/>
                        <!-- Adjustment takes remaining space so Action button sits at far right -->
                        <DataGridTextColumn Header="Adjustment" Binding="{Binding AdjustmentType}" Width="*"/>
                        <!-- small spacer before action -->
                        <DataGridTextColumn Header="" Width="16" CanUserResize="False" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Action" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁ï¸ View PDF" Tag="{Binding SalesReturnId}" Click="BtnView_Click"
                                            Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold" BorderThickness="0"
                                            Padding="8,4" Height="28" MinWidth="84" FontSize="12"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination Footer -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
                        <TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="PageSize_Changed">
                            <ComboBoxItem Content="10" IsSelected="True"/>
                            <ComboBoxItem Content="25"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                        </ComboBox>
                        <TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
                        <StackPanel x:Name="PanelPageNumbers" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid></UserControl>



