<UserControl x:Class="KrushiBillERP.Views.ProductsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:KrushiBillERP.Views"
			 Background="#F4F6F5">

	<UserControl.Resources>
		<local:StatusToBrushConverter x:Key="StatusToBrushConverter" />

		<!-- Palette -->
		<SolidColorBrush x:Key="PageBg" Color="#F4F6F5"/>
		<SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
		<SolidColorBrush x:Key="CardBorder" Color="#E7EBE8"/>
		<SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
		<SolidColorBrush x:Key="AccentGreenLight" Color="#E8F5E9"/>
		<SolidColorBrush x:Key="MutedText" Color="#6C757D"/>
		<SolidColorBrush x:Key="HeadingText" Color="#1E2422"/>
		<SolidColorBrush x:Key="RowHover" Color="#F5FAF5"/>
		<SolidColorBrush x:Key="RowSelected" Color="#E3F2E3"/>
		<SolidColorBrush x:Key="RowAlt" Color="#FAFCFB"/>

		<!-- Soft drop shadow reused on cards -->
		<DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.05" BlurRadius="14" ShadowDepth="2" Direction="270"/>

		<!-- Generic card Style -->
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource CardBg}"/>
			<Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Effect" Value="{StaticResource CardShadow}"/>
		</Style>

		<!-- Filter button Style (outline with icon) -->
		<Style x:Key="FilterButton" TargetType="Button">
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="{StaticResource HeadingText}" />
			<Setter Property="BorderBrush" Value="#D1D5DB" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="14,8" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>


		<!-- Rounded search / filter box look -->
		<Style x:Key="FieldTextBox" TargetType="TextBox">
			<Setter Property="Padding" Value="10,0,10,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderBrush" Value="#DADFDC"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Secondary (outline) button -->
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="{StaticResource HeadingText}"/>
			<Setter Property="BorderBrush" Value="#DADFDC"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#F2F4F2"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#F7F7F7"/>
								<Setter Property="Foreground" Value="#BFC4C1"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Premium Edit Action Button (Light Amber/Green) -->
		<Style x:Key="EditActionBtn" TargetType="Button">
			<Setter Property="Background" Value="#ECFDF5"/>
			<Setter Property="Foreground" Value="#059669"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,0,4,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Premium Delete Action Button (Light Red) -->
		<Style x:Key="DeleteActionBtn" TargetType="Button">
			<Setter Property="Background" Value="#FEF2F2"/>
			<Setter Property="Foreground" Value="#DC2626"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Stat card template -->
		<Style x:Key="StatCard" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource CardBg}"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="18,14"/>
			<Setter Property="Effect" Value="{StaticResource CardShadow}"/>
		</Style>

		<Style x:Key="PageNavBtn" TargetType="Button">
			<Setter Property="Height" Value="34"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#374151"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
								BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="bd" Property="Opacity" Value="0.35"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Margin="20" Background="{StaticResource PageBg}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 1. Header -->
		<DockPanel Grid.Row="0" Margin="0,0,0,16">
			<StackPanel Orientation="Vertical" DockPanel.Dock="Left">
				<TextBlock Text="Product Management" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
				<TextBlock Text="Manage agriculture &amp; pesticide products" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0"/>
			</StackPanel>
			<Button x:Name="BtnAddTop" Content="+ Add Product" HorizontalAlignment="Right" DockPanel.Dock="Right"
					Height="40" Padding="18,0" Click="BtnAdd_Click"
					Background="{StaticResource AccentGreen}" Foreground="White" BorderThickness="0"
					FontWeight="SemiBold" FontSize="13.5" Cursor="Hand">
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Button.Template>
			</Button>
		</DockPanel>

		<!-- 2. Stats Cards -->
		<Grid Grid.Row="1" Margin="0,0,0,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Card 1: TOTAL PRODUCTS -->
			<Border Grid.Column="0" Style="{StaticResource StatCard}">
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<Border Width="7" Height="7" CornerRadius="3.5" Background="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="TOTAL PRODUCTS" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="Bold"/>
					</StackPanel>
					<TextBlock x:Name="TxtTotal" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingText}" Margin="0,6,0,0"/>
				</StackPanel>
			</Border>

			<!-- Card 2: ACTIVE PRODUCTS -->
			<Border Grid.Column="2" Style="{StaticResource StatCard}">
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="ACTIVE PRODUCTS" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="Bold"/>
					</StackPanel>
					<TextBlock x:Name="TxtActive" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingText}" Margin="0,6,0,0"/>
				</StackPanel>
			</Border>

			<!-- Card 3: LOW STOCK -->
			<Border Grid.Column="4" Style="{StaticResource StatCard}">
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<Border Width="7" Height="7" CornerRadius="3.5" Background="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="LOW STOCK" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="Bold"/>
					</StackPanel>
					<TextBlock x:Name="TxtLowStock" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingText}" Margin="0,6,0,0"/>
				</StackPanel>
			</Border>

			<!-- Card 4: EXPIRING SOON -->
			<Border Grid.Column="6" Style="{StaticResource StatCard}">
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<Border Width="7" Height="7" CornerRadius="3.5" Background="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="EXPIRING SOON" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="Bold"/>
					</StackPanel>
					<TextBlock x:Name="TxtExpiring" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingText}" Margin="0,6,0,0"/>
				</StackPanel>
			</Border>
		</Grid>

		<!-- 3. Search & Filters Bar -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,16">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="420" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- Left: Search Box -->
				<Grid Grid.Column="0">
					<TextBox x:Name="TxtSearch" Height="38" Style="{StaticResource FieldTextBox}"
							 KeyDown="TxtSearch_KeyDown" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
							 TextChanged="TxtSearch_TextChanged" ToolTip="Search by product name, code, company or batch..."/>
				</Grid>

				<!-- Right: Buttons -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
					<Button Style="{StaticResource RefreshButton}" Height="38" Width="112" Click="BtnRefresh_Click" Margin="0,0,10,0"/>
					<Button x:Name="BtnFilter" Height="38" Style="{StaticResource FilterButton}" Click="BtnFilter_Click">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="⚙" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
							<TextBlock Text="Filters" FontSize="13" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<!-- Filter Popup -->
					<Popup x:Name="PopupFilter" PlacementTarget="{Binding ElementName=BtnFilter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
						<Border Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="16" Width="320">
							<StackPanel>
								<TextBlock Text="Filter Products" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
								<TextBlock Text="Category" FontSize="12" Foreground="#6C757D"/>
								<ComboBox x:Name="PopupCmbCategory" DisplayMemberPath="Name" Height="34" Margin="0,6,0,10" Style="{StaticResource ModernComboBox}"/>
								<TextBlock Text="Company" FontSize="12" Foreground="#6C757D"/>
								<ComboBox x:Name="PopupCmbCompany" Height="34" Margin="0,6,0,10" Style="{StaticResource ModernComboBox}"/>
								<TextBlock Text="Status" FontSize="12" Foreground="#6C757D"/>
								<ComboBox x:Name="PopupCmbStatus" Height="34" Margin="0,6,0,10" Style="{StaticResource ModernComboBox}">
									<ComboBoxItem Content="All Status" Tag="-1" />
									<ComboBoxItem Content="Active" Tag="1" />
									<ComboBoxItem Content="Inactive" Tag="0" />
								</ComboBox>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
									<Button Content="🔄 Reset" Click="BtnResetProductFilters_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,0"/>
									<Button Content="Apply" Click="BtnApplyProductFilters_Click" Background="{StaticResource AccentGreen}" Foreground="White" Height="34" Padding="14,0"/>
								</StackPanel>
							</StackPanel>
						</Border>
					</Popup>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 4. Product List -->
		<Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
			<DockPanel LastChildFill="True">
				<Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="18,14">
					<TextBlock Text="Product List" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeadingText}" />
				</Border>

				<Grid Margin="0">
					<DataGrid x:Name="DgProducts" AutoGenerateColumns="False" CanUserAddRows="False"
							  CanUserDeleteRows="False" IsReadOnly="True" RowHeight="52" HeadersVisibility="Column"
							  GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
							  AlternatingRowBackground="{StaticResource RowAlt}"
							  Style="{StaticResource PremiumDataGridStyle}" ColumnWidth="*" AlternationCount="2"
							  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

						<DataGrid.Resources>
							<Style x:Key="CellTextBlockCenter" TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center"/>
								<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
							</Style>
							<Style x:Key="CellTextBlockCenterBoth" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
								<Setter Property="TextAlignment" Value="Center"/>
								<Setter Property="HorizontalAlignment" Value="Center"/>
							</Style>
						</DataGrid.Resources>

						<DataGrid.Columns>
							<DataGridTextColumn Header="No" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
							<DataGridTextColumn Header="CODE" Binding="{Binding ProductCode}" Width="100" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="1.8*">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="FontWeight" Value="SemiBold"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTextColumn Header="COMPANY" Binding="{Binding Company}" Width="130" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Width="110" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="PACK" Binding="{Binding PackSize}" Width="65" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="65" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="P.PRICE" Binding="{Binding PurchasePrice, StringFormat='₹{0:N2}'}" Width="85" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="S.PRICE" Binding="{Binding SalePrice, StringFormat='₹{0:N2}'}" Width="85" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="STOCK" Binding="{Binding StockQty}" Width="75" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
							<DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}" Width="95" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDisplay}" Width="100" ElementStyle="{StaticResource CellTextBlockCenter}" />
							<DataGridTemplateColumn Header="STATUS" Width="100">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
												Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
											<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
												<Ellipse Width="7" Height="7" Fill="White" Margin="0,0,5,0" Opacity="0.9"/>
												<TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
											</StackPanel>
										</Border>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTemplateColumn x:Name="ColProductEditDelete" Header="ACTIONS" Width="140">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Button Content="✏ Edit" Style="{StaticResource EditActionBtn}" ToolTip="Edit Product" Click="BtnEdit_Click" />
											<Button Content="🗑 Delete" Style="{StaticResource DeleteActionBtn}" ToolTip="Delete Product" Click="BtnDelete_Click" />
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</DockPanel>
		</Border>

		<!-- 5. Pagination Footer -->
		<Border Grid.Row="4" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,14,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
					<TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
					<TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0"/>
					<ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="PageSize_Changed">
						<ComboBoxItem Content="10" IsSelected="True"/>
						<ComboBoxItem Content="25"/>
						<ComboBoxItem Content="50"/>
						<ComboBoxItem Content="100"/>
					</ComboBox>
					<TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="6,0,0,0"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Grid.Column="1">
					<Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
					<Border Background="{StaticResource AccentGreen}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
						<TextBlock x:Name="TxtPageInfo" Text="1" Foreground="White" FontWeight="Bold" FontSize="13"/>
					</Border>
					<Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click"/>
				</StackPanel>
			</Grid>
		</Border>

	</Grid>
</UserControl>
