<Window x:Class="KrushiBillERP.Views.InvoiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Invoice" Height="780" Width="980"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor">#2E7D32</SolidColorBrush>
        <SolidColorBrush x:Key="TextDark">#1E2422</SolidColorBrush>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderTitle" Text="Edit Bill / Invoice" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="Modify invoice items, prices or Customer. Stock will be automatically adjuSted." FontSize="12.5" Foreground="#6C757D" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="BtnClose_Click" Background="Transparent" Foreground="#6B7280" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand"/>
        </Grid>

        <!-- Form Body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Invoice Header Info -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Invoice No. 🔒" FontSize="11" Foreground="#6B7280"/>
                        <TextBox x:Name="TxtInvoiceNo" Style="{StaticResource FormTextBox}" IsReadOnly="True" FontWeight="Bold" Foreground="#1B5E20"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Invoice Date 🔒" FontSize="11" Foreground="#6B7280"/>
                        <TextBox x:Name="TxtInvoiceDate" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Customer / Farmer *" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbCustomer" DisplayMemberPath="Name" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Payment Method *" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbPaymentMethod" Height="34">
                            <ComboBoxItem Content="Cash" IsSelected="True"/>
                            <ComboBoxItem Content="Online"/>
                            <ComboBoxItem Content="Udhar"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Add New Item Row -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Select Product to Add" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbProduct" DisplayMemberPath="Name" Height="34" SelectionChanged="CmbProduct_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Qty" FontSize="11" Foreground="#6B7280"/>
                        <TextBox x:Name="TxtAddQty" Style="{StaticResource FormTextBox}" Text="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Rate ₹" FontSize="11" Foreground="#6B7280"/>
                        <TextBox x:Name="TxtAddRate" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="🔄 Add Item" Click="BtnAddItem_Click"
                            Style="{StaticResource PrimaryButton}" Height="34" VerticalAlignment="Bottom" Padding="14,0"/>
                </Grid>
            </Border>

            <!-- Items Grid -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="10">
                <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="1*"/>
                        <DataGridTextColumn Header="Rate ₹" Binding="{Binding Rate, StringFormat='₹ {0:N2}'}" Width="1.2*"/>
                        <DataGridTextColumn Header="GST %" Binding="{Binding GSTPercent, StringFormat='{}{0}%'}" Width="1*"/>
                        <DataGridTextColumn Header="Amount ₹" Binding="{Binding Amount, StringFormat='₹ {0:N2}'}" Width="1.4*" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Click="BtnRemoveItem_Click" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="6,2" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Totals Summary -->
            <Border Grid.Row="3" Background="#F8FAF9" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Subtotal" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtSubTotal" Text="₹ 0.00" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="GST Total" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtGstTotal" Text="₹ 0.00" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Grand Total" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtGrandTotal" Text="₹ 0.00" FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSave" Content="✓ Save Invoice Changes" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Height="36" Padding="20,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
