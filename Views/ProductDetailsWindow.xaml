<Window x:Class="KrushiBillERP.Views.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Details" Height="500" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource LightBg}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
                <TextBlock x:Name="LblName" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </Border>

            <!-- Details Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Product Code:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblCode" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Company:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblCompany" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Category:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblCategory" Grid.Row="2" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pack Size:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblPack" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Unit:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblUnit" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Purchase Price:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblPurchasePrice" Grid.Row="5" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sale Price:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblSalePrice" Grid.Row="6" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Batch No:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblBatch" Grid.Row="7" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Expiry Date:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblExpiry" Grid.Row="8" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="GST Rate:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblGst" Grid.Row="9" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Reorder Level:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblMinStock" Grid.Row="10" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Current Stock:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblStock" Grid.Row="11" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="HSN Code:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblHsn" Grid.Row="12" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Status:" FontWeight="Bold" Margin="0,4"/>
                    <TextBlock x:Name="LblStatus" Grid.Row="13" Grid.Column="1" Margin="0,4"/>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Button Grid.Row="2" Content="Close" Click="BtnClose_Click" Style="{StaticResource PrimaryButton}" Height="36" Width="100" HorizontalAlignment="Right" Margin="0,15,0,0"/>
        </Grid>
    </Border>
</Window>