<Page x:Class="KrushiBillERP.Views.BillingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Billing / Sales">

    <Page.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#059669"/>
        <SolidColorBrush x:Key="AccentGreenLight" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <SolidColorBrush x:Key="HeadingText" Color="#0F172A"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.03" BlurRadius="8" ShadowDepth="1" Direction="270"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentModeBtn" TargetType="RadioButton">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="14,8" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ECFDF5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Title & Header Actions -->
        <Grid Grid.Row="0" Margin="24,16,24,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Billing / Sales" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
                <TextBlock Text="Home  >  Billing / Sales  >  Add Bill" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="[F2: Farmer | F3: Product | F4: Amount | F8: Save]" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="BtnBillHistoryTab" Content="📜 Bill History" Style="{StaticResource OutlineBtn}" Height="38" Padding="16,0" Margin="0,0,10,0" Click="TabBillHistory_Click"/>
                <Button x:Name="BtnNewBillTab" Content="+ New Bill" Style="{StaticResource GreenBtn}" Height="38" Padding="18,0" Click="TabAddBill_Click"/>
            </StackPanel>
        </Grid>

        <!-- MAIN LAYOUT: 2-COLUMN SPLIT GRID -->
        <Grid Grid.Row="1" Margin="24,0,24,24">

            <!-- TAB 1: ADD BILL FORM (DEFAULT VIEW) -->
            <Grid x:Name="ViewAddBill" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Workflow Cards (1, 2, 3, 4, 7) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- StEP 1: FARMER / CustOMER CARD -->
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Farmer / Customer" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Farmer Search Input -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Search farmer by name or mobile number *" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBox x:Name="TxtFarmerSearch" Style="{StaticResource InputTextBox}" Height="42" KeyUp="TxtFarmerSearch_KeyUp" PreviewKeyDown="TxtFarmerSearch_PreviewKeyDown"/>
                                                <TextBlock x:Name="TxtFarmerSearchPlaceholder" Text="🔍 Search by farmer name or mobile number..." IsHitTestVisible="False" Foreground="#94A3B8" FontSize="13.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </Grid>
                                            <Button x:Name="BtnSelectFarmer" Grid.Column="1" Content="🔍 Select Customer / Farmer" Click="BtnSelectFarmer_Click" Style="{StaticResource GreenBtn}" Height="42" Padding="14,0" Margin="8,0,0,0" FontSize="12.5"/>
                                        </Grid>

                                        <!-- Autocomplete Popup -->
                                        <Border x:Name="PopupFarmerResults" Background="White" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="0,0,10,10" MaxHeight="220" Visibility="Collapsed" Margin="0,2,0,0" Panel.ZIndex="100">
                                            <ListBox x:Name="ListFarmers" BorderThickness="0" SelectionChanged="ListFarmers_SelectionChanged" PreviewKeyDown="ListFarmers_PreviewKeyDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Background="#ECFDF5" CornerRadius="16" Width="32" Height="32" Margin="0,0,0,10">
                                                                    <TextBlock Text="👤" Foreground="#059669" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FarmerName}" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                                                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="12,0,0,0">
                                                                        <Run Text="{Binding MobileNumber}"/>
                                                                        <Run Text="  •  "/>
                                                                        <Run Text="{Binding VillageName}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>

                                    <!-- Selected Farmer Details Box -->
                                    <Border Grid.Column="2" x:Name="PanelSelectedFarmer" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="14" Visibility="Visible">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#059669" CornerRadius="18" Width="36" Height="36" Margin="0,0,0,10">
                                                        <TextBlock Text="👤" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtSelectedFarmerName" Text="Ramesh Patel" FontWeight="Bold" FontSize="15" Foreground="#065F46"/>
                                                        <TextBlock x:Name="TxtSelectedFarmerMobile" Text="📞 9876543210" FontSize="12" Foreground="#047857" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,10,0,10">
                                                <TextBlock x:Name="TxtSelectedFarmerVillage" Text="📍 Idar" FontSize="12.5" Foreground="#047857" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="Current Outstanding: " FontSize="12" Foreground="#047857" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSelectedFarmerOutstanding" Text="₹ 12,500.00" FontWeight="Bold" FontSize="13.5" Foreground="#047857" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <Button x:Name="BtnChangeFarmer" Grid.Row="2" Content="✏️ Change Farmer" Click="BtnChangeFarmer_Click" Style="{StaticResource OutlineBtn}" Height="30" Padding="10,0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- StEP 2: BILL DETAILS CARD (NEW IN IMAGE) -->
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bill Details" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Invoice No (Locked) -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Invoice No." FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBox x:Name="TxtInvoiceNoDisplay" Style="{StaticResource InputTextBox}" Height="40" Text="INV-2026-00001" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold"/>
                                            <TextBlock Text="🔒" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#94A3B8"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Paper Bill No. -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Paper Bill No. *" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPaperBillNo" Style="{StaticResource InputTextBox}" Height="40" Text="PB-4587" FontWeight="SemiBold" KeyDown="TxtPaperBillNo_KeyDown"/>
                                    </StackPanel>

                                    <!-- Bill Date -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Bill Date *" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                        <DatePicker x:Name="DpBillDate" Height="40" FontSize="13.5" VerticalContentAlignment="Center" KeyDown="DpBillDate_KeyDown"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- StEP 3: ADD PRODUCTS CARD -->
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add Products" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Search Input -->
                                <Grid Margin="0,0,0,12">
                                    <TextBox x:Name="TxtProductSearch" Style="{StaticResource InputTextBox}" Height="42" KeyUp="TxtProductSearch_KeyUp" PreviewKeyDown="TxtProductSearch_PreviewKeyDown"/>
                                    <TextBlock x:Name="TxtProductSearchPlaceholder" Text="St Search product by name / company / batch / barcode..." IsHitTestVisible="False" Foreground="#94A3B8" FontSize="13.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>

                                <!-- Autocomplete Products LiSt Table -->
                                <Border x:Name="PopupProductResults" Background="White" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="8" MaxHeight="240" Visibility="Collapsed" Margin="0,0,0,12">
                                    <DataGrid x:Name="GridProductSuggestions" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="Horizontal" SelectionChanged="GridProductSuggestions_SelectionChanged" PreviewKeyDown="GridProductSuggestions_PreviewKeyDown">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="1.8*" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="1*"/>
                                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="90"/>
                                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplay}" Width="100"/>
                                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQty}" Width="70" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Price (₹)" Binding="{Binding SalePrice, StringFormat=N2}" Width="90" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="GST" Binding="{Binding GSTPercent, StringFormat={}{0}%}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Selected Add Qty Bar -->
                                <Border x:Name="PanelAddBar" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtAddProdName" Text="Coragen (Bayer)" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                            <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0">
                                                <Run Text="Batch: "/><Run x:Name="TxtAddBatch" Text="C-101" FontWeight="SemiBold"/>
                                                <Run Text="  |  Exp: "/><Run x:Name="TxtAddExp" Text="21 Aug 2027"/>
                                                <Run Text="  |  Stock: "/><Run x:Name="TxtAddStock" Text="20" FontWeight="Bold" Foreground="#059669"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="Qty *" FontSize="11" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtQty" Style="{StaticResource InputTextBox}" Height="36" Text="1" FontWeight="Bold" TextAlignment="Center" KeyDown="TxtQty_KeyDown"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="Rate (₹) *" FontSize="11" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtRate" Style="{StaticResource InputTextBox}" Height="36" FontWeight="Bold"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" x:Name="BtnAddItem" Content="┼ Add" Click="BtnAddItem_Click" Style="{StaticResource GreenBtn}" Height="36" Padding="16,0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- StEP 4: BILL ITEMS CARD -->
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bill Items" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Items Table (IsReadOnly=True so cell edit is disabled) -->
                                <DataGrid x:Name="GridItems" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="44" Background="White" BorderThickness="1" BorderBrush="#E2E8F0">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12.5"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="90"/>
                                        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplay}" Width="100"/>
                                        <DataGridTemplateColumn Header="Qty" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="-" Click="BtnQtyMinus_Click" Tag="{Binding ProductId}" Width="26" Height="26" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" Cursor="Hand"/>
                                                        <TextBlock Text="{Binding Qty}" FontWeight="Bold" FontSize="14" Margin="10,0" VerticalAlignment="Center"/>
                                                        <Button Content="🔄" Click="BtnQtyPlus_Click" Tag="{Binding ProductId}" Width="26" Height="26" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" Cursor="Hand"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Rate (₹)" Binding="{Binding Rate, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="GST" Binding="{Binding GSTPercent, StringFormat={}{0}%}" Width="60"/>
                                        <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat=N2}" Width="110" FontWeight="Bold"/>
                                        <DataGridTemplateColumn Header="Action" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑" Click="BtnRemoveItem_Click" Tag="{Binding ProductId}" Background="#FEF2F2" Foreground="#EF4444" BorderThickness="0" Width="30" Height="30" FontSize="13" Cursor="Hand" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- ACTION BUTTONS -->
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🗑 Clear Bill" Click="BtnClearBill_Click" Style="{StaticResource OutlineBtn}" Height="44" Padding="20,0" Margin="0,0,12,0"/>
                                <Button x:Name="BtnSaveBill" Content="✓ Save Bill" Click="BtnSaveBill_Click" Style="{StaticResource GreenBtn}" Height="44" Padding="28,0" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT COLUMN: Payment Details (5), Summary (6) & Notice -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CARD 5: PAYMENT DETAILS (TOP RIGHT) -->
                        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="5" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Payment Details" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Payment Mode *" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton x:Name="RadioCash" Content="💵 Cash" GroupName="PayMode" IsChecked="True" Checked="PayMode_Changed" Style="{StaticResource PaymentModeBtn}"/>
                                    <RadioButton x:Name="RadioUpi" Content="📱 UPI / Online" GroupName="PayMode" Checked="PayMode_Changed" Style="{StaticResource PaymentModeBtn}"/>
                                    <RadioButton x:Name="RadioUdhar" Content="📜 Udhar" GroupName="PayMode" Checked="PayMode_Changed" Style="{StaticResource PaymentModeBtn}"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelUpiRef" Visibility="Collapsed" Margin="0,0,0,10">
                                    <TextBlock Text="UPI Reference / UTR *" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtUpiRef" Style="{StaticResource InputTextBox}" Height="38"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelAmountReceived" Margin="0,0,0,10">
                                    <TextBlock Text="Amount Received *" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtAmountReceived" Style="{StaticResource InputTextBox}" Height="40" FontSize="15" FontWeight="Bold" Foreground="#059669" KeyUp="TxtAmountReceived_KeyUp" KeyDown="TxtAmountReceived_KeyDown"/>
                                </StackPanel>

                                <TextBlock Text="Outstanding / Udhar" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <Grid>
                                    <TextBox x:Name="TxtBillOutstanding" Style="{StaticResource InputTextBox}" Height="40" FontSize="15" FontWeight="Bold" Foreground="#64748B" Background="#F1F5F9" IsReadOnly="True"/>
                                    <TextBlock Text="🔒" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#94A3B8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 6: BILL SUMMARY -->
                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="6" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bill Summary" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Subtotal" FontSize="13.5" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtSubTotal" Text="₹ 1,750.00" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Discount Row with % Box -->
                                <Grid Margin="0,6">
                                    <TextBlock Text="Discount (%)" FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="110" Height="32">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                                <TextBlock Text="%" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBox Grid.Column="1" x:Name="TxtDiscount" Text="0" BorderThickness="0" FontSize="13" FontWeight="Bold" TextAlignment="Right" VerticalContentAlignment="Center" Padding="0,0,8,0" KeyUp="TxtDiscount_KeyUp" TextChanged="TxtDiscount_TextChanged"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Taxable Amount" FontSize="13.5" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtTaxable" Text="₹ 1,650.00" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <TextBlock Text="GST (18%)" FontSize="13.5" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtGstTotal" Text="₹ 297.00" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Round Off" FontSize="13.5" Foreground="#64748B"/>
                                    <TextBlock Text="₹ 0.00" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Separator Margin="0,12" Background="#E2E8F0"/>

                                <Grid Margin="0,4">
                                    <TextBlock Text="Grand Total" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGrandTotal" Text="₹ 1,947.00" FontSize="22" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Payment Summary Box -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Payment Mode" FontSize="12.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtSummaryPayMode" Text="Cash" FontSize="13" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Amount Received" FontSize="12.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtSummaryReceived" Text="₹ 1,947.00" FontSize="13" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="Outstanding / Udhar" FontSize="12.5" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtSummaryOutstanding" Text="₹ 0.00" FontSize="13" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Post-SAVE INFO NOTICE BOX -->
                        <Border x:Name="PostSaveNotice" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="⚠️  After saving the bill, you will get options to:" FontSize="12" FontWeight="Bold" Foreground="#92400E" Margin="0,0,8,0"/>
                                <TextBlock Text="📄  Download PDF" FontSize="12" Foreground="#B45309" Margin="0,4,0,0"/>
                                <TextBlock Text="🖨  Print Invoice" FontSize="12" Foreground="#B45309" Margin="0,2,0,0"/>
                                <TextBlock Text="💬  Send via WhatsApp" FontSize="12" Foreground="#B45309" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: BILL History SCREEN -->
            <Grid x:Name="ViewBillHistory" Visibility="Collapsed">
                <Frame x:Name="FrameBillHistory" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
