<Page x:Class="KrushiBillERP.Views.BillingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Billing / Sales"
      Background="#F4F6F5">

    <Page.Resources>
        <!-- Theme Color Palette -->
        <SolidColorBrush x:Key="PageBg" Color="#F4F6F5"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E7EBE8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentGreenDark" Color="#1B5E20"/>
        <SolidColorBrush x:Key="AccentGreenLight" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="MutedText" Color="#6C757D"/>
        <SolidColorBrush x:Key="HeadingText" Color="#1E2422"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>

        <!-- Card Container Style -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Section Header Text -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingText}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Field Label Text -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Form TextBox -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio Button Pill Style for Payment Mode -->
        <Style x:Key="PaymentModeBtn" TargetType="RadioButton">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F5E9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Green Button -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGreenDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Title & Header Actions -->
        <Grid Grid.Row="0" Margin="20,16,20,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Billing / Sales" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
                <TextBlock Text="Fast farmer billing and invoice generation" FontSize="12.5" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="[F2: Farmer | F3: Product | F4: Amount | F8: Save]" FontSize="12" Foreground="#6C757D" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- MAIN LAYOUT: 2-COLUMN SPLIT GRID -->
        <Grid Grid.Row="1" Margin="20,0,20,20">

            <!-- TAB 1: ADD BILL FORM (DEFAULT VIEW) -->
            <Grid x:Name="ViewAddBill" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Customer, Invoice Details, Product Entry & Items Table -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- CARD 1: CUSTOMER & INVOICE DETAILS -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="CUSTOMER &amp; INVOICE DETAILS" Style="{StaticResource SectionHeader}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                     <!-- Farmer Search Input with Dropdown Popup -->
                                     <StackPanel Grid.Column="0">
                                         <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="Customer / Farmer" Style="{StaticResource FieldLabel}"/>
                                             <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                         </StackPanel>
                                         <Grid>
                                             <TextBox x:Name="TxtFarmerSearch" Style="{StaticResource InputTextBox}" Height="38" KeyUp="TxtFarmerSearch_KeyUp" PreviewKeyDown="TxtFarmerSearch_PreviewKeyDown"/>
                                             <TextBlock x:Name="TxtFarmerSearchPlaceholder" Text="Search by farmer name or mobile..." IsHitTestVisible="False" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                             <Button x:Name="BtnSelectFarmer" Visibility="Collapsed" Click="BtnSelectFarmer_Click"/>
                                         </Grid>

                                         <!-- Real-Time Filtered Farmer Dropdown Floating Popup -->
                                         <Popup x:Name="PopupFarmerResults" IsOpen="False" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtFarmerSearch}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                                             <Border Background="White" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" Width="{Binding ElementName=TxtFarmerSearch, Path=ActualWidth}" MaxHeight="220" Margin="0,2,0,0">
                                                 <Border.Effect>
                                                     <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                                                 </Border.Effect>
                                                 <ListBox x:Name="ListFarmers" BorderThickness="0" PreviewMouseLeftButtonUp="ListFarmers_PreviewMouseLeftButtonUp" PreviewKeyDown="ListFarmers_PreviewKeyDown">
                                                     <ListBox.ItemTemplate>
                                                         <DataTemplate>
                                                             <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                                                 <Grid>
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*"/>
                                                                         <ColumnDefinition Width="Auto"/>
                                                                     </Grid.ColumnDefinitions>
                                                                     <TextBlock Grid.Column="0" Text="{Binding FarmerName}" FontWeight="Bold" FontSize="13" Foreground="#1E2422" VerticalAlignment="Center"/>
                                                                     <TextBlock Grid.Column="1" Text="{Binding MobileNumber}" FontSize="12" Foreground="#6C757D" VerticalAlignment="Center"/>
                                                                 </Grid>
                                                             </Border>
                                                         </DataTemplate>
                                                     </ListBox.ItemTemplate>
                                                 </ListBox>
                                             </Border>
                                         </Popup>

                                         <!-- Hidden compatibility ComboBox -->
                                         <ComboBox x:Name="CmbFarmerSelect" Visibility="Collapsed"/>
                                     </StackPanel>

                                    <!-- Selected Farmer Info Badge -->
                                    <Border Grid.Column="2" x:Name="PanelSelectedFarmer" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Visible">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtSelectedFarmerName" Text="Ramesh Patel" FontWeight="Bold" FontSize="13.5" Foreground="#1B5E20"/>
                                                    <TextBlock x:Name="TxtSelectedFarmerMobile" Text=" (📞 9876543210)" FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="BtnChangeFarmer" Content="✏️ Change" Click="BtnChangeFarmer_Click" Style="{StaticResource OutlineBtn}" Height="24" Padding="8,0" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <TextBlock x:Name="TxtSelectedFarmerVillage" Text="📍 Idar" FontSize="11.5" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="Outstanding: " FontSize="11.5" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtSelectedFarmerOutstanding" Text="₹ 0.00" FontWeight="Bold" FontSize="12.5" Foreground="#1B5E20" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Bill No, Paper Bill No & Bill Date Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Invoice No (Locked) -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Invoice No." Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="TxtInvoiceNoDisplay" Style="{StaticResource InputTextBox}" Height="38" Text="INV-2026-00001" IsReadOnly="True" FontWeight="Bold"/>
                                            <TextBlock Text="🔒" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9CA3AF"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Paper Bill No. -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Paper Bill No." Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtPaperBillNo" Style="{StaticResource InputTextBox}" Height="38" Text="PB-4587" FontWeight="SemiBold" KeyDown="TxtPaperBillNo_KeyDown"/>
                                    </StackPanel>

                                    <!-- Bill Date -->
                                    <StackPanel Grid.Column="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bill Date" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                        </StackPanel>
                                        <DatePicker x:Name="DpBillDate" Height="38" FontSize="13" VerticalContentAlignment="Center" KeyDown="DpBillDate_KeyDown"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: ADD PRODUCT -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="ADD PRODUCTS" Style="{StaticResource SectionHeader}"/>

                                <!-- Product Search Bar -->
                                <Grid Margin="0,0,0,10">
                                    <TextBox x:Name="TxtProductSearch" Style="{StaticResource InputTextBox}" Height="40" KeyUp="TxtProductSearch_KeyUp" PreviewKeyDown="TxtProductSearch_PreviewKeyDown"/>
                                    <TextBlock x:Name="TxtProductSearchPlaceholder" Text="🔍 Search product by name / company / batch / barcode..." IsHitTestVisible="False" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <!-- Autocomplete Products Floating Popup -->
                                    <Popup x:Name="PopupProductResults" IsOpen="False" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtProductSearch}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" Width="{Binding ElementName=TxtProductSearch, Path=ActualWidth}" MaxHeight="220" Margin="0,2,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                                            </Border.Effect>
                                            <ListBox x:Name="ListProducts" BorderThickness="0" PreviewMouseLeftButtonUp="ListProducts_PreviewMouseLeftButtonUp" PreviewKeyDown="ListProducts_PreviewKeyDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1E2422"/>
                                                                    <TextBlock FontSize="11.5" Foreground="#6C757D" Margin="0,1,0,0">
                                                                        <Run Text="{Binding Company}"/>
                                                                        <Run Text=" • Batch: "/>
                                                                        <Run Text="{Binding BatchNo}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding SalePrice, StringFormat='₹{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                                                    <TextBlock FontSize="11.5" Foreground="#6C757D" HorizontalAlignment="Right" Margin="0,1,0,0">
                                                                        <Run Text="Stock: "/>
                                                                        <Run Text="{Binding StockQty}" FontWeight="SemiBold"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>

                                    <!-- Hidden DataGrid for backward compatibility -->
                                    <DataGrid x:Name="GridProductSuggestions" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Selected Product Add Bar -->
                                <Border x:Name="PanelAddBar" Background="#F8FAF9" BorderBrush="#E0E5E2" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtAddProdName" Text="Coragen (Bayer)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource HeadingText}"/>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,2,0,0">
                                                <Run Text="Batch: "/><Run x:Name="TxtAddBatch" Text="C-101" FontWeight="SemiBold"/>
                                                <Run Text=" | Exp: "/><Run x:Name="TxtAddExp" Text="21 Aug 2027"/>
                                                <Run Text=" | Stock: "/><Run x:Name="TxtAddStock" Text="20" FontWeight="Bold" Foreground="#2E7D32"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="Qty *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtQty" Style="{StaticResource InputTextBox}" Height="34" Text="1" FontWeight="Bold" TextAlignment="Center" KeyDown="TxtQty_KeyDown"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Text="Rate (₹) *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtRate" Style="{StaticResource InputTextBox}" Height="34" FontWeight="Bold"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" x:Name="BtnAddItem" Content="+ Add Item" Click="BtnAddItem_Click" Style="{StaticResource GreenBtn}" Height="34" Padding="14,0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: BILLED ITEMS TABLE -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="BILLED ITEMS" Style="{StaticResource SectionHeader}"/>

                                <DataGrid x:Name="GridItems" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="42"
                                          Background="White" BorderThickness="1" BorderBrush="#E0E5E2"
                                          Style="{StaticResource PremiumDataGridStyle}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAF9"/>
                                            <Setter Property="Foreground" Value="#495057"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12.5"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E0E5E2"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="90"/>
                                        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplay}" Width="100"/>
                                        <DataGridTemplateColumn Header="Qty" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="-" Click="BtnQtyMinus_Click" Tag="{Binding ProductId}" Width="24" Height="24" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" FontWeight="Bold" Cursor="Hand"/>
                                                        <TextBlock Text="{Binding Qty}" FontWeight="Bold" FontSize="13.5" Margin="8,0" VerticalAlignment="Center"/>
                                                        <Button Content="+" Click="BtnQtyPlus_Click" Tag="{Binding ProductId}" Width="24" Height="24" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" FontWeight="Bold" Cursor="Hand"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Rate (₹)" Binding="{Binding Rate, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="GST" Binding="{Binding GSTPercent, StringFormat={}{0}%}" Width="60"/>
                                        <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat=N2}" Width="110" FontWeight="Bold"/>
                                        <DataGridTemplateColumn Header="Action" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑" Click="BtnRemoveItem_Click" Tag="{Binding ProductId}" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Width="28" Height="28" FontSize="12" Cursor="Hand" HorizontalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT COLUMN: Payment Details, Summary & Actions -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CARD 4: PAYMENT DETAILS -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="PAYMENT DETAILS" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Payment Mode *" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton x:Name="RadioCash" Content="💵 Cash" GroupName="PayMode" IsChecked="True" Checked="PayMode_Changed" Style="{StaticResource PaymentModeBtn}"/>
                                    <RadioButton x:Name="RadioUpi" Content="📱 UPI" GroupName="PayMode" Checked="PayMode_Changed" Style="{StaticResource PaymentModeBtn}"/>
                                    <RadioButton x:Name="RadioUdhar" Content="📜 Udhar" GroupName="PayMode" Checked="PayMode_Changed" Style="{StaticResource PaymentModeBtn}"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelUpiRef" Visibility="Collapsed" Margin="0,0,0,10">
                                    <TextBlock Text="UPI Reference / UTR *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtUpiRef" Style="{StaticResource InputTextBox}" Height="38"/>
                                </StackPanel>

                                <StackPanel x:Name="PanelAmountReceived" Margin="0,0,0,10">
                                    <TextBlock Text="Amount Received *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtAmountReceived" Style="{StaticResource InputTextBox}" Height="40" FontSize="15" FontWeight="Bold" Foreground="#1B5E20" KeyUp="TxtAmountReceived_KeyUp" KeyDown="TxtAmountReceived_KeyDown"/>
                                </StackPanel>

                                <TextBlock Text="Outstanding / Udhar" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <TextBox x:Name="TxtBillOutstanding" Style="{StaticResource InputTextBox}" Height="40" FontSize="15" FontWeight="Bold" Foreground="#6C757D" Background="#F3F4F6" IsReadOnly="True"/>
                                    <TextBlock Text="🔒" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9CA3AF"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 5: INVOICE SUMMARY -->
                        <Border Style="{StaticResource SectionCard}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="INVOICE SUMMARY" Style="{StaticResource SectionHeader}"/>

                                <Grid Margin="0,4">
                                    <TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TxtSubTotal" Text="₹ 0.00" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Discount Row -->
                                <Grid Margin="0,6">
                                    <TextBlock Text="Discount (%)" FontSize="13" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Width="100" Height="32">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                                                <TextBlock Text="%" FontSize="12" FontWeight="Bold" Foreground="#6C757D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBox Grid.Column="1" x:Name="TxtDiscount" Text="0" BorderThickness="0" FontSize="13" FontWeight="Bold" TextAlignment="Right" VerticalContentAlignment="Center" Padding="0,0,8,0" KeyUp="TxtDiscount_KeyUp" TextChanged="TxtDiscount_TextChanged"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,4">
                                    <TextBlock Text="Taxable Amount" FontSize="13" Foreground="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TxtTaxable" Text="₹ 0.00" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <TextBlock Text="GST Total" FontSize="13" Foreground="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TxtGstTotal" Text="₹ 0.00" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Separator Margin="0,10" Background="#E0E5E2"/>

                                <Grid Margin="0,4">
                                    <TextBlock Text="Grand Total" FontSize="15" FontWeight="Bold" Foreground="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGrandTotal" Text="₹ 0.00" FontSize="20" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Payment Summary Breakdown Box -->
                                <Border Background="#F8FAF9" BorderBrush="#E0E5E2" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Payment Mode" FontSize="12" Foreground="{StaticResource MutedText}"/>
                                            <TextBlock x:Name="TxtSummaryPayMode" Text="Cash" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Amount Received" FontSize="12" Foreground="{StaticResource MutedText}"/>
                                            <TextBlock x:Name="TxtSummaryReceived" Text="₹ 0.00" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Outstanding / Udhar" FontSize="12" Foreground="{StaticResource MutedText}"/>
                                            <TextBlock x:Name="TxtSummaryOutstanding" Text="₹ 0.00" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CARD 6: ACTIONS -->
                        <Border Style="{StaticResource SectionCard}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="🗑 Clear" Click="BtnClearBill_Click" Style="{StaticResource OutlineBtn}" Height="40" Padding="0"/>
                                <Button Grid.Column="2" x:Name="BtnSaveBill" Content="✓ Save &amp; Print Bill" Click="BtnSaveBill_Click" Style="{StaticResource GreenBtn}" Height="40" Padding="0" FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Post-SAVE INFO NOTICE BOX -->
                        <Border x:Name="PostSaveNotice" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="⚠️ After saving the bill, options available:" FontSize="11.5" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,4"/>
                                <TextBlock Text="📄 Download PDF | 🖨 Print | 💬 WhatsApp" FontSize="11" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: BILL HISTORY SCREEN -->
            <Grid x:Name="ViewBillHistory" Visibility="Collapsed">
                <Frame x:Name="FrameBillHistory" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
