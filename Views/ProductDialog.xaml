<Window x:Class="KrushiBillERP.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Product" Height="620" Width="760" WindowStartupLocation="CenterOwner" ResizeMode="NoReSize" Background="#F4F6F5">

    <Window.Resources>
        <SolidColorBrush x:Key="LockedBg">#F3F4F6</SolidColorBrush>
        <SolidColorBrush x:Key="LockedBorder">#D1D5DB</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryColor">#2E7D32</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryDark">#1B5E20</SolidColorBrush>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E5E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E2422"/>
            <Setter Property="BorderBrush" Value="#DADFDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F4F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="📦 Add Product (From Purchase Entry)" FontSize="17" FontWeight="Bold" Foreground="#1E2422"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Select a product from Purchase Entry. Purchased details are locked 🔒; set selling price and category below." FontSize="12" Foreground="#6C757D" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Purchase Item Selector -->
                <Border x:Name="PanelPurchaseSelection" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="📦 Select Product / Batch from Purchase Entry" Style="{StaticResource FieldLabel}" Foreground="#1B5E20" FontWeight="Bold"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbPurchaseItem" Height="36" FontSize="13" VerticalContentAlignment="Center"
                                  SelectionChanged="CmbPurchaseItem_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- Product Parameters Grid -->
                <Border Style="{StaticResource CardStyle}">
                    <UniformGrid Columns="2" Rows="8">
                        <!-- Product Code / SKU (Auto-generated & Locked) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Product Code / SKU (Auto) 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCode" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}" Foreground="#1B5E20" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Product Name (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Product Name 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtName" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Company (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Company Name 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCompany" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}"/>
                        </StackPanel>

                        <!-- Category (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Category 🔒" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" Height="34" VerticalContentAlignment="Center" IsEnabled="False"/>
                        </StackPanel>

                        <!-- Batch Number (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Batch Number 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtBatch" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}"/>
                        </StackPanel>

                        <!-- Expiry Date (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Expiry Date 🔒" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DpExpiry" Height="34" IsEnabled="False"/>
                        </StackPanel>

                        <!-- Purchase Price (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Purchase Price (₹) 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPurchasePrice" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Selling Price (EDITABLE) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Selling Price (₹) *" Style="{StaticResource FieldLabel}" Foreground="#2E7D32"/>
                            <TextBox x:Name="TxtSellingPrice" Style="{StaticResource FormTextBox}" BorderBrush="#2E7D32" BorderThickness="1.5" FontWeight="Bold" Foreground="#1B5E20"/>
                        </StackPanel>

                        <!-- GST % (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="GST (%) 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtGst" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}"/>
                        </StackPanel>

                        <!-- Stock Qty (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock x:Name="LblPurchaseStockQty" Text="Stock Qty 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPurchaseStockQty" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Pack Size (Editable) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Pack Size *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPackSize" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>

                        <!-- Unit (Editable) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Unit *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbUnit" Height="34" VerticalContentAlignment="Center">
                                <ComboBoxItem>ML</ComboBoxItem>
                                <ComboBoxItem>Litre</ComboBoxItem>
                                <ComboBoxItem>Gram</ComboBoxItem>
                                <ComboBoxItem>KG</ComboBoxItem>
                                <ComboBoxItem>Piece</ComboBoxItem>
                                <ComboBoxItem>Bottle</ComboBoxItem>
                                <ComboBoxItem>Packet</ComboBoxItem>
                                <ComboBoxItem>Box</ComboBoxItem>
                                <ComboBoxItem>Bag</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- Minimum Stock Alert (Editable) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Minimum Stock Alert *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtMinStock" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>

                        <!-- HSN Code (Locked from Purchase) -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="HSN Code 🔒" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtHsn" Style="{StaticResource FormTextBox}" IsReadOnly="True" Background="{StaticResource LockedBg}"/>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Margin="6,4">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbStatus" Height="34" VerticalContentAlignment="Center">
                                <ComboBoxItem Tag="1" IsSelected="True">Active</ComboBoxItem>
                                <ComboBoxItem Tag="0">Inactive</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Height="38" Width="100" Margin="0,0,0,10" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="BtnSave" Content="✓ Save Product" Height="38" Width="140" Click="BtnSave_Click" Style="{StaticResource GreenPrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
