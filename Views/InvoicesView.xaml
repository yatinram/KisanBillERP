<Page x:Class="KrushiBillERP.Views.InvoicesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Bill History">

    <Page.Resources>
        <!-- Exact Payment Receipt Color Tokens -->
        <SolidColorBrush x:Key="PageBg"       Color="#F4F6F5"/>
        <SolidColorBrush x:Key="CardBg"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor"  Color="#E0E5E2"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2E7D32"/>
        <SolidColorBrush x:Key="PrimaryDark"  Color="#1B5E20"/>
        <SolidColorBrush x:Key="TextDark"     Color="#1E2422"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#6C757D"/>

        <!-- Section Card Style (Matching PaymentReceiptWindow) -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Form TextBox Style (Matching PaymentReceiptWindow) -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Green Button (Matching PaymentReceiptWindow) -->
        <Style x:Key="GreenPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PDF Action Button -->
        <Style x:Key="PdfActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Action Button -->
        <Style x:Key="DeleteActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Button (Prev/Next) -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBg}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 1. HEADER ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bill History" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="View and manage farmer billing History" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ 2. CustOMER DETAILS CARD (EXACT PAYMENT RECEIPT WINDOW StYLING) ══ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="CustOMER DETAILS" FontSize="13.5" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Select Customer / Farmer Field -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Customer / Farmer" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="TxtFarmerSearch" Style="{StaticResource FormTextBox}" Height="36" KeyUp="TxtFarmerSearch_KeyUp" PreviewKeyDown="TxtFarmerSearch_PreviewKeyDown"/>
                            <TextBlock x:Name="HintFarmer" Text="Search by name or mobile..." IsHitTestVisible="False"
                                       Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Mobile Number Field 🔒 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mobile Number 🔒" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtMobile" Style="{StaticResource FormTextBox}" IsReadOnly="True" Height="36" Background="#F3F4F6" Foreground="#1B5E20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Village Field 🔒 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Village 🔒" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtVillage" Style="{StaticResource FormTextBox}" IsReadOnly="True" Height="36" Background="#F3F4F6" Foreground="#1B5E20" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Farmer Autocomplete Floating Popup -->
                <Popup x:Name="PopupFarmer" IsOpen="False" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtFarmerSearch}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" Width="{Binding ElementName=TxtFarmerSearch, Path=ActualWidth}" MaxHeight="200" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                        </Border.Effect>
                        <ListBox x:Name="ListFarmers" BorderThickness="0" PreviewMouseLeftButtonUp="ListFarmers_PreviewMouseLeftButtonUp" PreviewKeyDown="ListFarmers_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FarmerName}" FontWeight="Bold" FontSize="13" Foreground="#1E2422" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MobileNumber}" FontSize="12" Foreground="#6C757D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <!-- Date Range Section (Filter button on right) -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Date Range" Style="{StaticResource FieldLabel}" Grid.Column="0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Refresh button -->
                        <Button x:Name="BtnRefresh" Style="{StaticResource RefreshButton}" Height="38" Width="112" Margin="0,0,8,0" Click="BtnRefresh_Click"/>

                        <!-- Filter button (opens popup with date range pickers) -->
                        <Button x:Name="BtnFilter" Height="36" Margin="0,0,0,0" Click="BtnFilter_Click"
                                Background="White" BorderBrush="#E5EAE7" BorderThickness="1" Padding="12,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Filters" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Filter Popup -->
                        <Popup x:Name="PopupFilter" PlacementTarget="{Binding ElementName=BtnFilter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
                            <Border Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="12" Width="420">
                                <StackPanel>
                                    <TextBlock Text="Filter Bills" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Start Date" FontSize="12" Foreground="#6C757D"/>
                                    <DatePicker x:Name="PopupDpFrom" Height="36" Margin="0,6,0,10" />
                                    <TextBlock Text="End Date" FontSize="12" Foreground="#6C757D"/>
                                    <DatePicker x:Name="PopupDpTo" Height="36" Margin="0,6,0,10" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="🔄 Reset" Click="BtnResetFilters_Click" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0"/>
                                        <Button Content="Apply" Click="BtnApplyFilters_Click" Height="36" Padding="12,0" Background="{StaticResource PrimaryColor}" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <!-- Hidden date pickers preserved for code-behind compatibility -->
                <DatePicker x:Name="DpFrom" Visibility="Collapsed" SelectedDateChanged="DateFilter_Changed" />
                <DatePicker x:Name="DpTo" Visibility="Collapsed" SelectedDateChanged="DateFilter_Changed" />
            </StackPanel>
        </Border>

        <!-- ═ ═ ═  3. BILLS History TABLE SECTION ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═ ═  -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Card Header -->
                <Grid Grid.Row="0" Margin="18,14">
                    <TextBlock Text="Bills History" FontSize="15" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Total: " FontSize="13" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtTotalBadge" Text="0 Bills" FontSize="13.5" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" x:Name="PanelEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40" Visibility="Visible">
                    <TextBlock Text="👨‍🌾" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtEmptyTitle" Text="Select a Farmer to View Bill History" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEmptySubtitle" Text="Please search and select a farmer above to display their bills." FontSize="12.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- DataGrid: No | Bill No. | Date | Farmer Name | Amount | Action (PDF ONLY!) -->
                <DataGrid x:Name="GridInvoices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column"
                          Background="White" BorderThickness="1" BorderBrush="{StaticResource BorderColor}"
                          Style="{StaticResource PremiumDataGridStyle}" ColumnWidth="*"
                          Visibility="Collapsed">

                    <DataGrid.Resources>
                        <Style x:Key="CellTextBlockCenter" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                        <Style x:Key="CellTextBlockCenterBoth" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="CellTextBlockRight" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding RowNo}" Width="50" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat='dd MMM yyyy'}" Width="110" ElementStyle="{StaticResource CellTextBlockCenter}" />
                        <DataGridTextColumn Header="Farmer" Binding="{Binding FarmerName}" Width="*" ElementStyle="{StaticResource CellTextBlockCenter}" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding TotalQty}" Width="65" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, StringFormat=₹{0:N2}}" Width="120" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="95" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=₹{0:N2}}" Width="105" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTextColumn Header="Payable" Binding="{Binding PayableAmount, StringFormat=₹{0:N2}}" Width="105" ElementStyle="{StaticResource CellTextBlockCenterBoth}" />
                        <DataGridTemplateColumn Header="Status" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partially Returned">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="● Active"/>
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Partially Returned">
                                                            <Setter Property="Text" Value="● Partial Return"/>
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                            <Setter Property="Text" Value="● Returned"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Text" Value="● Cancelled"/>
                                                            <Setter Property="Foreground" Value="#757575"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="BtnEditRow" Content="Edit" Click="BtnEdit_Click" Style="{StaticResource GreenPrimaryButton}" Tag="{Binding Id}" Margin="0,0,4,0" Loaded="BtnEditRow_Loaded"/>
                                        <Button x:Name="BtnDeleteRow" Content="Delete" Click="BtnDelete_Click" Style="{StaticResource DeleteActionBtn}" Tag="{Binding Id}" Margin="0,0,4,0" Loaded="BtnDeleteRow_Loaded"/>
                                        <Button Content="PDF" Click="BtnPdf_Click" Style="{StaticResource PdfActionBtn}" Tag="{Binding Id}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ 4. PAGINATION FOOTER ═════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E5E2" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
                    <TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="CmbPageSize_Changed">
                        <ComboBoxItem Content="10" IsSelected="True"/>
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                    <TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
                    <StackPanel x:Name="PanelPageNums" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid></Page>

