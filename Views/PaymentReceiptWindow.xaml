<Window x:Class="KrushiBillERP.Views.PaymentReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Payment Receipt" Height="850" Width="1060"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor">#2E7D32</SolidColorBrush>
        <SolidColorBrush x:Key="TextDark">#1E2422</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#6C757D</SolidColorBrush>
        <SolidColorBrush x:Key="BorderColor">#E0E5E2</SolidColorBrush>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Payment Mode Toggle Button -->
        <Style x:Key="PayModeBtn" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="8" Padding="16,10" Cursor="Hand" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8F5E9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2E7D32"/>
                                <Setter Property="Foreground" Value="#1B5E20"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0FFF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="GroupName" Value="PayMode"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderTitle" Text="New Payment Receipt" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Record and allocate Customer payment againSt Outstanding invoices" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="BtnClose_Click" Background="Transparent" Foreground="#6B7280" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Main ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- CustOMER DETAILS CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="CustOMER DETAILS" FontSize="13.5" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Select Farmer -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Customer / Farmer" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="TxtFarmerSearch" Style="{StaticResource FormTextBox}" Height="36" KeyUp="TxtFarmerSearch_KeyUp" PreviewKeyDown="TxtFarmerSearch_PreviewKeyDown"/>
                                    <TextBlock x:Name="HintFarmer" Text="Search by name or mobile..." IsHitTestVisible="False" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <!-- Farmer Autocomplete Floating Popup -->
                                    <Popup x:Name="PopupFarmerResults" IsOpen="False" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtFarmerSearch}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="6" Width="{Binding ElementName=TxtFarmerSearch, Path=ActualWidth}" MaxHeight="200" Margin="0,2,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                                            </Border.Effect>
                                            <ListBox x:Name="ListFarmerResults" BorderThickness="0" PreviewMouseLeftButtonUp="ListFarmerResults_PreviewMouseLeftButtonUp" PreviewKeyDown="ListFarmerResults_PreviewKeyDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding FarmerName}" FontWeight="Bold" FontSize="13" Foreground="#1E2422" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding MobileNumber}" FontSize="12" Foreground="#6C757D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                    <!-- Hidden ComboBox for backward compatibility -->
                                    <ComboBox x:Name="CmbFarmerSelect" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>

                            <!-- Mobile -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Mobile Number 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtMobile" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Village -->
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Village 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtVillage" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Receipt Date -->
                            <StackPanel Grid.Column="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Receipt Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <DatePicker x:Name="DpReceiptDate" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PAYMENT DETAILS CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PAYMENT DETAILS" FontSize="13.5" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Opening Balance -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Opening Balance 🔒" Style="{StaticResource FieldLabel}"/>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="10,0" Height="36">
                                    <TextBlock x:Name="TxtOpeningBalance" Text="₹ 0.00" FontSize="15" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Received Amount -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Received Amount" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtReceivedAmount" Style="{StaticResource FormTextBox}" FontWeight="Bold" FontSize="15"
                                         TextChanged="TxtReceivedAmount_TextChanged"/>
                            </StackPanel>

                            <!-- Payment Mode -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment Mode" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbCash" Content="💵  Cash" IsChecked="True" Style="{StaticResource PayModeBtn}" Checked="PaymentMode_Changed"/>
                                    <RadioButton x:Name="RbUPI" Content="📱  UPI / Online" Style="{StaticResource PayModeBtn}" Checked="PaymentMode_Changed"/>
                                    <RadioButton x:Name="RbCheque" Content="📝  Cheque" Style="{StaticResource PayModeBtn}" Checked="PaymentMode_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Transaction Reference (UPI) -->
                        <StackPanel x:Name="PanelTransRef" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="Transaction Reference" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtTransRef" Style="{StaticResource FormTextBox}" Width="350" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Cheque Details -->
                        <Grid x:Name="PanelCheque" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cheque Number" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtChequeNo" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cheque Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <DatePicker x:Name="DpChequeDate" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bank Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtBankName" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PAYMENT ALLOCATION CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="PAYMENT ALLOCATION" FontSize="13.5" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                            <Button x:Name="BtnAutoAllocate" Content="⚡ Auto Allocate" Click="BtnAutoAllocate_Click"
                                    HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" FontSize="12"/>
                        </Grid>

                        <!-- Empty State -->
                        <Border x:Name="BorderAllocEmpty" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtAllocEmpty" Text="Please select a Customer/farmer to view Outstanding invoices for allocation."
                                       Foreground="#6B7280" FontSize="13" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>

                        <DataGrid x:Name="GridAllocations" AutoGenerateColumns="False" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="38"
                                  MaxHeight="250" Background="White" BorderThickness="1" BorderBrush="#E5EAE7">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAF9"/>
                                    <Setter Property="Foreground" Value="#495057"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice No." Binding="{Binding InvoiceNo}" Width="150" IsReadOnly="True" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate, StringFormat=dd MMM yyyy}" Width="120" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Invoice Total" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InvoiceTotal, StringFormat='₹ {0:N2}'}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Outstanding" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InvoiceOutstanding, StringFormat='₹ {0:N2}'}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Allocation *" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding AllocatedAmount, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="Allocation_TextChanged" Height="28" Padding="6,0"
                                                     VerticalContentAlignment="Center" FontWeight="Bold" Foreground="#1B5E20"
                                                     BorderBrush="#2E7D32" BorderThickness="1"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="TxtAllocStatus" Foreground="#DC2626" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalAllocated" Text="Total Allocated: ₹ 0.00" FontSize="13.5" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BALANCE SUMMARY 🔄 NOTES -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Balance Summary -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="BALANCE SUMMARY" FontSize="13.5" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Opening Balance" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtSummaryOpening" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Received Amount" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtSummaryReceived" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,4,0,8" Background="#E5E7EB"/>
                            <Grid>
                                <TextBlock Text="Closing Balance" FontSize="15" FontWeight="Bold" Foreground="#1E2422"/>
                                <TextBlock x:Name="TxtSummaryClosing" Text="₹ 0.00" FontSize="18" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="NOTES" FontSize="13.5" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                            <TextBox x:Name="TxtNotes" Style="{StaticResource FormTextBox}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtSavingStatus" Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" Height="40" Padding="20,0" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave" Content="✓ Save Payment Receipt" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
