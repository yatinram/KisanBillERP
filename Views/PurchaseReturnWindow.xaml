<Window x:Class="KrushiBillERP.Views.PurchaseReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Purchase Return" Height="820" Width="1040"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryColor">#2E7D32</SolidColorBrush>
        <SolidColorBrush x:Key="TextDark">#1E2422</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#6C757D</SolidColorBrush>
        <SolidColorBrush x:Key="BorderColor">#E0E5E2</SolidColorBrush>

        <!-- Section Border Card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeaderTitle" Text="New Purchase Return" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Create a return againSt an exiSting purchase" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="BtnClose_Click" Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                    FontSize="16" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Main Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!-- PURCHASE DETAILS CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PURCHASE DETAILS" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Select Purchase dropdown 🔄 search -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Purchase No." Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbSelectPurchase" IsEditable="True" Style="{StaticResource FormComboBox}" Height="36"
                                          IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="CmbSelectPurchase_KeyUp"
                                          SelectionChanged="CmbSelectPurchase_SelectionChanged" DisplayMemberPath="Display"/>
                            </StackPanel>

                            <!-- Return Date -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Return Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <DatePicker x:Name="DpReturnDate" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Supplier Name (READ-ONLY) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Supplier Name 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtSupplierName" Style="{StaticResource FormTextBox}" IsReadOnly="True" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Supplier Invoice No (READ-ONLY) -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Supplier Invoice No. 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtSupplierInvoice" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Paper Bill No (READ-ONLY) -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Paper Bill No. 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPaperBill" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Original Purchase Date (READ-ONLY) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Purchase Date 🔒" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtPurchaseDate" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RETURN ITEMS CARD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="RETURN ITEMS" Style="{StaticResource SectionHeader}"/>

                        <!-- Empty State notice when no purchase selected -->
                        <Border x:Name="BorderEmptyNotice" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtEmptyNotice" Text="Please click 'St Select Purchase' above to load purchased products for return."
                                       Foreground="#6B7280" FontSize="13.5" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>

                        <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  MaxHeight="300"
                                  Style="{StaticResource PremiumDataGridStyle}" IsReadOnly="False"
                                  ColumnWidth="*" RowHeight="52" AlternationCount="2"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No" Binding="{Binding PurchaseReturnItemId}" Width="40" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="1*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}" Width="1*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Purchased" Binding="{Binding PurchasedQuantity}" Width="1*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Already Returned" Binding="{Binding AlreadyReturnedQuantity}" Width="1*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Returnable" Binding="{Binding ReturnableQuantity}" Width="1*" IsReadOnly="True" />

                                    <!-- Editable Return Qty shown as boxed input -->
                                    <DataGridTemplateColumn Header="Return Qty" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FFF4" CornerRadius="6" Padding="4" HorizontalAlignment="Center">
                                                    <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReturnQty_TextChanged"
                                                             Style="{StaticResource FormTextBox}" Width="72" HorizontalContentAlignment="Right"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Purchase Rate" Binding="{Binding PurchasePrice, StringFormat='₹ {0:N2}'}" Width="1*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="GST" Binding="{Binding GST, StringFormat='{}{0}%'}" Width="1*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹ {0:N2}'}" Width="1*" FontWeight="Bold" IsReadOnly="True" />
                                </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- RETURN DETAILS & SUMMARY CARD -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RETURN DETAILS -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="RETURN DETAILS" Style="{StaticResource SectionHeader}"/>

                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Return Reason" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbReason" Style="{StaticResource FormComboBox}" SelectionChanged="CmbReason_SelectionChanged">
                                    <ComboBoxItem Content="Damaged" IsSelected="True"/>
                                    <ComboBoxItem Content="Expired"/>
                                    <ComboBoxItem Content="Wrong Product"/>
                                    <ComboBoxItem Content="Excess Quantity"/>
                                    <ComboBoxItem Content="Quality Issue"/>
                                    <ComboBoxItem Content="Supplier RequeSt"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="PanelOtherReason" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Specify Reason" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox x:Name="TxtOtherReason" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Notes / Remarks" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtNotes" Style="{StaticResource FormTextBox}" Height="54" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RETURN SUMMARY -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="RETURN SUMMARY" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtSubTotal" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Discount" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtDiscount" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Taxable Amount" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtTaxableAmount" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="GST Amount" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtGstAmount" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Round Off" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtRoundOff" Text="₹ 0.00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,8,0,10" Background="#E5E7EB"/>

                            <Grid>
                                <TextBlock Text="RETURN TOTAL" FontSize="15" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock x:Name="TxtGrandTotal" Text="₹ 0.00" FontSize="18" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtSavingStatus" Text="" Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" Height="40" Padding="20,0" Margin="0,0,0,10"/>
                <Button x:Name="BtnSaveReturn" Content="✓ Save Purchase Return" Click="BtnSaveReturn_Click" Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
