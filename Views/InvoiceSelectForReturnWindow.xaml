<Window x:Class="KrushiBillERP.Views.InvoiceSelectForReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Bill / Invoice for Sales Return" Height="560" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Select Bill / Invoice for Return" FontSize="18" FontWeight="Bold" Foreground="#1E2422"/>
                <TextBlock Text="Search by Farmer Name, Mobile, Village or Bill / Invoice Number" FontSize="12" Foreground="#6C757D" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E7EBE8" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <TextBox x:Name="TxtSearch" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyUp="TxtSearch_KeyUp"/>
                <TextBlock x:Name="TxtSearchPlaceholder" Text="St Search farmer name, mobile or bill number..." Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Invoices DataGrid -->
        <DataGrid x:Name="GridInvoices" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowHeight="40" Background="White" BorderThickness="1" BorderBrush="#E5EAE7"
                  MouseDoubleClick="GridInvoices_MouseDoubleClick">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAF9"/>
                    <Setter Property="Foreground" Value="#495057"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Bill No." Binding="{Binding InvoiceNo}" Width="110" FontWeight="Bold" Foreground="#1B5E20"/>
                <DataGridTextColumn Header="Farmer Name" Binding="{Binding FarmerName}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat='dd MMM yyyy'}" Width="110"/>
                <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" Width="110" FontWeight="Bold"/>
                <DataGridTextColumn Header="Udhar Balance" Binding="{Binding PayableAmount, StringFormat='₹ {0:N2}'}" Width="110" Foreground="#C62828"/>
                <DataGridTemplateColumn Header="Status" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Active"/>
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Partially Returned">
                                                <Setter Property="Text" Value="Partial Return"/>
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                <Setter Property="Text" Value="Returned"/>
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Select" Click="BtnSelect_Click" Background="#E8F5E9" Foreground="#2E7D32" FontWeight="SemiBold" BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Background="#E0E0E0" Foreground="#333" Width="100" Height="34" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
