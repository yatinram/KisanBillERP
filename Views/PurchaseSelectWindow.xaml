<Window x:Class="KrushiBillERP.Views.PurchaseSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Purchase for Return" Height="580" Width="840"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E2422"/>

        <Style x:Key="SelectButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Select Purchase" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="Search and select an exiSting purchase to record returns" FontSize="12.5" Foreground="#6C757D" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="BtnCancel_Click" Background="Transparent" Foreground="#6B7280" BorderThickness="0" FontSize="15" FontWeight="Bold"/>
        </Grid>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="TxtSearch" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                     FontSize="13" KeyUp="TxtSearch_KeyUp"/>
            <TextBlock x:Name="TxtSearchPlaceholder" Text="St Search by purchase no., supplier name, invoice no..."
                       IsHitTestVisible="False" Foreground="#9E9E9E" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Purchases DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="GridPurchases" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      RowHeight="40" Background="White" MouseDoubleClick="GridPurchases_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAF9"/>
                        <Setter Property="Foreground" Value="#495057"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding PurchaseId}" Width="50" />
                    <DataGridTextColumn Header="Purchase No." Binding="{Binding PurchaseNumber}" Width="150" FontWeight="Bold" />
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                    <DataGridTextColumn Header="Invoice No." Binding="{Binding SupplierInvoiceNumber}" Width="130" />
                    <DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDate, StringFormat=dd MMM yyyy}" Width="130" />
                    <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" Width="120" />
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Select" Click="BtnSelect_Click" Style="{StaticResource SelectButton}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Height="36" Padding="18,0"/>
        </StackPanel>
    </Grid>
</Window>
