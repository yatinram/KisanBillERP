<UserControl x:Class="KrushiBillERP.Views.StockView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#F4F6F5"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E7EBE8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="AccentGreenDark" Color="#1B5E20"/>
        <SolidColorBrush x:Key="MutedText" Color="#6C757D"/>
        <SolidColorBrush x:Key="HeadingText" Color="#1E2422"/>

        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource HeadingText}" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="BorderBrush" Value="#DADFDC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryGreenButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGreenDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingText}"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdjustButton" TargetType="Button">
            <Setter Property="Background" Value="#FEF3C7"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDE68A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageNavBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Stock Inventory &amp; Adjustments" FontSize="22" FontWeight="Bold" Foreground="{StaticResource HeadingText}"/>
                <TextBlock Text="Monitor live product stock, valuations, low stock alerts, and audit adjustments" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnAdjustmentLog" Content="📋 Adjustment Audit Log" Click="BtnAdjustmentLog_Click"
                        Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,10,0"/>
                <Button x:Name="BtnNewAdjustment" Content="✏ New Stock Adjustment" Click="BtnNewAdjustment_Click"
                        Style="{StaticResource PrimaryGreenButton}" Height="38" Padding="16,0"/>
            </StackPanel>
        </Grid>

        <!-- Stat Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total SKUs -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL PRODUCTS" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBlock x:Name="StatTotalSkus" Text="0" FontSize="20" FontWeight="Bold" Foreground="#374151" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Valuation -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL STOCK VALUATION" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBlock x:Name="StatValuation" Text="₹ 0.00" FontSize="20" FontWeight="Bold" Foreground="#1B5E20" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Low Stock Count -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="LOW STOCK ALERTS" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBlock x:Name="StatLowStock" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Expiring Soon Count -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="EXPIRING SOON (15 DAYS)" FontSize="11" FontWeight="Bold" Foreground="#6C757D"/>
                    <TextBlock x:Name="StatExpiring" Text="0" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Card -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search & Filter Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtSearch" Height="40" Style="{StaticResource SearchTextBox}" KeyUp="Filter_Changed"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Search product name, code, batch..."
                                   IsHitTestVisible="False" Foreground="#9E9E9E" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RefreshButton}" Height="38" Width="112" Click="BtnRefresh_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnFilter" Height="40" Style="{StaticResource FilterButton}" Click="BtnFilter_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Filters" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Hidden filter combos preserved for code-behind compatibility -->
                    <ComboBox x:Name="CmbCategoryFilter" Visibility="Collapsed" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="CmbStatusFilter" Visibility="Collapsed" SelectionChanged="Filter_Changed"/>

                    <!-- Filter Popup -->
                    <Popup x:Name="PopupFilter" PlacementTarget="{Binding ElementName=BtnFilter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
                        <Border Background="White" BorderBrush="#E5EAE7" BorderThickness="1" CornerRadius="8" Padding="14" Width="300">
                            <StackPanel>
                                <TextBlock Text="Filter Stocks" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Category" FontSize="12" Foreground="#6C757D"/>
                                <ComboBox x:Name="PopupCmbCategory" DisplayMemberPath="Name" Height="34" Margin="0,6,0,10" Style="{StaticResource ModernComboBox}"/>
                                <TextBlock Text="Stock Level" FontSize="12" Foreground="#6C757D"/>
                                <ComboBox x:Name="PopupCmbStatus" Height="34" Margin="0,6,0,10" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="All Stock Levels" />
                                    <ComboBoxItem Content="In Stock" />
                                    <ComboBoxItem Content="Low Stock" />
                                    <ComboBoxItem Content="Out of Stock" />
                                    <ComboBoxItem Content="Expiring Soon" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="🔄 Reset" Click="BtnResetFilters_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,0"/>
                                    <Button Content="Apply" Click="BtnApplyFilters_Click" Style="{StaticResource PrimaryGreenButton}" Height="34" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="GridStock" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" HeadersVisibility="Column"
                          Background="White" BorderThickness="0"
                          Style="{StaticResource PremiumDataGridStyle}" ColumnWidth="*" RowHeight="52"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style x:Key="CellTextBlockCenter" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                        <Style x:Key="CellTextBlockCenterBoth" TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockCenter}">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CellTextBlockCenterBoth}"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="100" ElementStyle="{StaticResource CellTextBlockCenter}"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="1.8*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="1.2*" ElementStyle="{StaticResource CellTextBlockCenter}"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="1.2*" ElementStyle="{StaticResource CellTextBlockCenter}"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="100" ElementStyle="{StaticResource CellTextBlockCenter}"/>
                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDisplay}" Width="110" ElementStyle="{StaticResource CellTextBlockCenter}"/>
                        <DataGridTemplateColumn Header="Current Stock" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockQty}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="100" ElementStyle="{StaticResource CellTextBlockCenterBoth}"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F5E9" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StockStatus}" Foreground="#2E7D32" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="📊 History" Click="BtnHistoryRow_Click" Tag="{Binding Id}"
                                                Background="#E0F2FE" Foreground="#0284C7" BorderThickness="0"
                                                Padding="8,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#BAE6FD"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="✏ Adjust" Click="BtnAdjustRow_Click" Tag="{Binding Id}" Style="{StaticResource AdjustButton}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination Footer -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtShowingInfo" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,12,0" Text="Showing 0 to 0 of 0 entries"/>
                        <TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbPageSize" Width="70" Height="30" Style="{StaticResource ModernComboBox}" SelectionChanged="PageSize_Changed">
                            <ComboBoxItem Content="10" IsSelected="True"/>
                            <ComboBoxItem Content="25"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                        </ComboBox>
                        <TextBlock Text="entries" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedText}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="BtnPrev" Content="Previous" Style="{StaticResource PageNavBtn}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
                        <StackPanel x:Name="PanelPageNumbers" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Button x:Name="BtnNext" Content="Next" Style="{StaticResource PageNavBtn}" Click="BtnNext_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
