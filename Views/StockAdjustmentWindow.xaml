<Window x:Class="KrushiBillERP.Views.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment" Height="540" Width="680" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F4F6F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Stock Adjustment" FontSize="24" FontWeight="Bold" Foreground="#2E7D32"/>
                <TextBlock Text="Correct inventory quantity with reason and audit trail" FontSize="14" Foreground="#666666"/>
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Width="30" Height="30" 
                    Background="Transparent" BorderThickness="0" 
                    FontSize="16" FontWeight="Bold" Foreground="#666666"
                    Click="BtnClose_Click" VerticalAlignment="Top"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Product & Batch -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Product *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbProduct" DisplayMemberPath="Name" 
                                  SelectionChanged="CmbProduct_SelectionChanged" Height="35"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Batch Number" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#E0E0E0" CornerRadius="4">
                            <TextBox x:Name="TxtBatch" IsReadOnly="True" Height="35" 
                                     Background="Transparent" BorderThickness="0" Padding="5"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Current Stock & Adjustment Type -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current Stock Qty" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border Background="#E0E0E0" CornerRadius="4">
                            <TextBox x:Name="TxtCurrentStock" IsReadOnly="True" FontWeight="Bold" 
                                     Height="35" Background="Transparent" BorderThickness="0" Padding="5"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Adjustment Type *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbType" Height="35">
                            <ComboBoxItem Content="🔄 Add Stock"/>
                            <ComboBoxItem Content="- Reduce Stock"/>
                            <ComboBoxItem Content="= Set Exact Stock"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Quantity & Reason -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quantity *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="TxtQuantity" Height="35" BorderThickness="0" Padding="5"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reason *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbReason" SelectionChanged="CmbReason_SelectionChanged" Height="35">
                            <ComboBoxItem Content="Damage / Spoilage"/>
                            <ComboBoxItem Content="Expired Stock"/>
                            <ComboBoxItem Content="Physical Audit Correction"/>
                            <ComboBoxItem Content="Supplier Return Adjustment"/>
                            <ComboBoxItem Content="Sample / Demo"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Specify Reason (Other) -->
                <StackPanel x:Name="PanelSpecifyReason" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Specify Reason *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="TxtSpecifyReason" Height="35" BorderThickness="0" Padding="5"/>
                    </Border>
                </StackPanel>

                <!-- Notes -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Notes / Remarks" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="TxtNotes" Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                                 BorderThickness="0" Padding="5"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" 
                        Width="100" Height="40" Margin="0,0,0,10"/>
                <Button Content="✓ Save Adjustment" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" 
                        Width="160" Height="40"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
